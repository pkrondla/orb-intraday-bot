    orbLongWhipsawLabel := label.new(bar_index, labelY, labelText, color=color.orange, style=label.style_label_up, textcolor=color.white, size=size.small, tooltip="Additional Whipsaw for ORB Long - ORH holding as support. SL will not hit. Higher probability signal.")
    line.new(bar_index, labelY, bar_index, low + connectionGap, color=color.orange, width=1, style=line.style_dashed)
    orbLongWhipsawTriggered := true

// Additional Whipsaw for ORB Short - Show enhanced label
if showEntrySignals and shouldShowSignals() and orbShortAdditionalWhipsaw and not orbShortWhipsawTriggered
    orbShortWhipsawTime := getCurrentTimeString()
    // Enhanced whipsaw label
    labelText = "WHIPSAW"
