    // 🚀 ON-SCREEN ALERT for BULL TRAP ENTRY
    if showEntryAlerts and enableOnScreenAlerts
        alertMsg = "BULL TRAP ENTRY\nEntry: " + str.tostring(bullTrapEntry, "#.##") + "\nSL: " + str.tostring(bullTrapStop, "#.##") + "\nTarget: " + str.tostring(bullTrapTarget, "#.##") + "\nStrategy: ORH breakout failed\nConfirmation: Swing low break"
        array.push(alertMessages, alertMsg)
        array.push(alertTypes, "ENTRY")
        array.push(alertBarIndexes, bar_index)
        array.push(alertColors, color.red)
        array.push(alertPriorities, 3)
        array.push(alertIcons, "⚡")
        array.push(alertDismissed, false)
        array.push(alertIDs, alertCounter)
        alertCounter += 1
    
    bullTrapTriggered := true

if showTrapSignals and shouldShowSignals() and bearTrapCondition and not bearTrapTriggered and isValidZoneForSignal("BEAR_TRAP")
    bearTrapEntryTime := getCurrentTimeString()
    // Minimal chart label
    labelText = "BEAR TRAP"
    labelY = getLabelY(low, false, "TRAP")
    tooltipText = "BEAR TRAP SIGNAL\nEntry Time: " + bearTrapEntryTime + "\nEntry: " + str.tostring(bearTrapEntry, "#.##") + "\nStop Loss: " + str.tostring(bearTrapStop, "#.##") + "\nTarget: " + str.tostring(bearTrapTarget, "#.##") + "\nStrategy: After ORL breakdown, candle closed above ORL. Confirmation at swing high break."
    bearTrapLabel := label.new(bar_index, labelY, labelText, color=color.green, style=label.style_label_up, textcolor=color.white, size=size.small, tooltip=tooltipText)
    line.new(bar_index, labelY, bar_index, low + connectionGap, color=color.green, width=1, style=line.style_dashed)
    // Add to trade table
