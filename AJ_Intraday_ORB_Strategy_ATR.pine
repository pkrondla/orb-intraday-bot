// ============================================================================
// TRADE TABLE MANAGEMENT
// ============================================================================



// Function to add trade to table data with position sizing
addTradeToTable(signal, entryTime, entry, stop, target, quantity, riskAmount, status, pnl, barIndex) =>
    // Add to arrays
    array.push(tradeSignals, signal)
    array.push(tradeTimes, entryTime)
    array.push(tradeExitTimes, "-")  // Initialize with "-", will be updated when trade exits
    array.push(tradeEntries, entry)
    array.push(tradeStops, stop) 
    array.push(tradeTargets, target)
    array.push(tradeQuantities, quantity)      // New: Position quantity
    array.push(tradeRiskAmounts, riskAmount)   // New: Risk amount
    array.push(tradeStatuses, status)
    array.push(tradePnLs, pnl)
    array.push(tradeBars, barIndex)
    
    // Keep only max rows
    if array.size(tradeSignals) > maxTableRows
        array.shift(tradeSignals)
        array.shift(tradeTimes)
        array.shift(tradeExitTimes)
        array.shift(tradeEntries)
        array.shift(tradeStops)
        array.shift(tradeTargets)
        array.shift(tradeQuantities)      // New array management
        array.shift(tradeRiskAmounts)     // New array management
        array.shift(tradeStatuses)
        array.shift(tradePnLs)
        array.shift(tradeBars)

// Function to update trade status in table
updateTradeStatus(signal, newStatus, newPnL) =>
    // Check if all required arrays are valid and have data
    if array.size(tradeSignals) > 0 and array.size(tradeStatuses) > 0 and array.size(tradePnLs) > 0 and array.size(tradeExitTimes) > 0
        arraySize = array.size(tradeSignals)
        statusSize = array.size(tradeStatuses)
        pnlSize = array.size(tradePnLs)
        exitTimeSize = array.size(tradeExitTimes)
        
        // Verify all arrays are the same size
        if arraySize == statusSize and arraySize == pnlSize and arraySize == exitTimeSize
            // Safe to proceed with array access
            for i = arraySize - 1 to 0
                if i >= 0 and i < arraySize  // Extra bounds check
                    currentSignal = array.get(tradeSignals, i)
                    currentStatus = array.get(tradeStatuses, i)
                    if currentSignal == signal and str.contains(currentStatus, "Active")
                        array.set(tradeStatuses, i, newStatus)
                        array.set(tradePnLs, i, newPnL)
                        array.set(tradeExitTimes, i, getCurrentTimeString())
                        break

// Update trade table (not a function - direct execution)
if showTradeTable and barstate.islast
    // Delete existing table
    if not na(tradeTable)
        table.delete(tradeTable)
    
    // Calculate table size
    tableSize = math.min(array.size(tradeSignals), maxTableRows)
    
    // Always create table, even if no trades (to show headers)
    // Create new table
    tablePos = switch tablePosition
        "top_center" => position.top_center
        "top_right" => position.top_right
        "top_left" => position.top_left
        "middle_center" => position.middle_center
        "middle_right" => position.middle_right
        "middle_left" => position.middle_left
        "bottom_center" => position.bottom_center
        "bottom_right" => position.bottom_right
        "bottom_left" => position.bottom_left
        => position.top_right  // Default to top_right
    
    // Create table with at least 2 rows (header + 1 data row minimum) - Now 10 columns
    tableRows = math.max(tableSize + 1, 2)
    newTable = table.new(tablePos, 10, tableRows, bgcolor=color.black, border_width=3, border_color=color.yellow)
    tradeTable := newTable
    
    // Header row - High contrast for dark mode (10 columns now)
    table.cell(tradeTable, 0, 0, "Signal", text_color=color.white, text_size=size.normal, bgcolor=color.navy)
    table.cell(tradeTable, 1, 0, "Entry Time", text_color=color.white, text_size=size.normal, bgcolor=color.navy)
    table.cell(tradeTable, 2, 0, "Exit Time", text_color=color.white, text_size=size.normal, bgcolor=color.navy)
    table.cell(tradeTable, 3, 0, "Entry", text_color=color.white, text_size=size.normal, bgcolor=color.navy)
    table.cell(tradeTable, 4, 0, "SL", text_color=color.white, text_size=size.normal, bgcolor=color.navy)
    table.cell(tradeTable, 5, 0, "Target", text_color=color.white, text_size=size.normal, bgcolor=color.navy)
    table.cell(tradeTable, 6, 0, "Qty", text_color=color.white, text_size=size.normal, bgcolor=color.navy)
    table.cell(tradeTable, 7, 0, "Risk(₹)", text_color=color.white, text_size=size.normal, bgcolor=color.navy)
    table.cell(tradeTable, 8, 0, "Status", text_color=color.white, text_size=size.normal, bgcolor=color.navy)
    table.cell(tradeTable, 9, 0, "P&L", text_color=color.white, text_size=size.normal, bgcolor=color.navy)
    
    // Data rows or show "No Trades" message
    if tableSize > 0
        for i = 0 to tableSize - 1
            if i < array.size(tradeSignals)
                row = i + 1
                signal = array.get(tradeSignals, i)
                entryTime = array.get(tradeTimes, i)
                exitTime = array.get(tradeExitTimes, i)
                entry = array.get(tradeEntries, i)
                stop = array.get(tradeStops, i)
                target = array.get(tradeTargets, i)
                quantity = array.get(tradeQuantities, i)     // New: Position quantity
                riskAmount = array.get(tradeRiskAmounts, i)  // New: Risk amount
                status = array.get(tradeStatuses, i)
                pnl = array.get(tradePnLs, i)
                
                // Skip inactive trades if showOnlyActive is enabled
                if showOnlyActive and not str.contains(status, "Active")
                    continue
                
                // Determine text colors based on status - White background with colored text
                textColor = str.contains(status, "Target") ? color.green : 
                           str.contains(status, "SL Hit") ? color.red : 
                           color.orange
                
                // White background for all rows
                rowColor = color.white
                pnlColor = pnl > 0 ? color.green : pnl < 0 ? color.red : color.gray
                
                table.cell(tradeTable, 0, row, signal, text_color=textColor, text_size=size.small, bgcolor=rowColor)
                table.cell(tradeTable, 1, row, entryTime, text_color=textColor, text_size=size.small, bgcolor=rowColor)
                table.cell(tradeTable, 2, row, exitTime, text_color=textColor, text_size=size.small, bgcolor=rowColor)
                table.cell(tradeTable, 3, row, str.tostring(entry, "#.##"), text_color=textColor, text_size=size.small, bgcolor=rowColor)
                // Calculate points for SL and Target
                slPoints = math.abs(entry - stop)
                targetPoints = math.abs(target - entry)
                
                // Format with price and points
                slText = str.tostring(stop, "#.##") + "\n(" + str.tostring(slPoints, "#.#") + "pts)"
                targetText = str.tostring(target, "#.##") + "\n(" + str.tostring(targetPoints, "#.#") + "pts)"
                
                table.cell(tradeTable, 4, row, slText, text_color=textColor, text_size=size.small, bgcolor=rowColor)
                table.cell(tradeTable, 5, row, targetText, text_color=textColor, text_size=size.small, bgcolor=rowColor)
                table.cell(tradeTable, 6, row, str.tostring(quantity), text_color=textColor, text_size=size.small, bgcolor=rowColor)
                table.cell(tradeTable, 7, row, str.tostring(riskAmount, "#"), text_color=textColor, text_size=size.small, bgcolor=rowColor)
                table.cell(tradeTable, 8, row, status, text_color=textColor, text_size=size.small, bgcolor=rowColor)
                table.cell(tradeTable, 9, row, (pnl > 0 ? "+" : "") + str.tostring(pnl, "#.##"), text_color=pnlColor, text_size=size.small, bgcolor=rowColor)
    else
        // Show "No Trades" message when no trades are available - White background with colored text (10 columns)
        noTradesBg = color.white
        table.cell(tradeTable, 0, 1, "No Trades", text_color=color.gray, text_size=size.small, bgcolor=noTradesBg)
        table.cell(tradeTable, 1, 1, "Yet", text_color=color.gray, text_size=size.small, bgcolor=noTradesBg)
        table.cell(tradeTable, 2, 1, "-", text_color=color.gray, text_size=size.small, bgcolor=noTradesBg)
        table.cell(tradeTable, 3, 1, "-", text_color=color.gray, text_size=size.small, bgcolor=noTradesBg)
        table.cell(tradeTable, 4, 1, "-", text_color=color.gray, text_size=size.small, bgcolor=noTradesBg)
        table.cell(tradeTable, 5, 1, "-", text_color=color.gray, text_size=size.small, bgcolor=noTradesBg)
        table.cell(tradeTable, 6, 1, "-", text_color=color.gray, text_size=size.small, bgcolor=noTradesBg)
        table.cell(tradeTable, 7, 1, "-", text_color=color.gray, text_size=size.small, bgcolor=noTradesBg)
        table.cell(tradeTable, 8, 1, "-", text_color=color.gray, text_size=size.small, bgcolor=noTradesBg)
        table.cell(tradeTable, 9, 1, "-", text_color=color.gray, text_size=size.small, bgcolor=noTradesBg)

// ============================================================================
// ZONE ALLOCATION SYSTEM
// ============================================================================

// Define signal zones (from top to bottom)
getSignalZone(signalType) =>
    switch signalType
        "CONS_BREAKOUT" => 5    // Top zone - Consolidation breakouts
        "ORB" => 4              // Upper zone - ORB signals
        "ZONE_INFO" => 3        // Middle zone - Zone information  
        "TRAP" => 2             // Lower zone - Bull/Bear traps
        "WHIPSAW" => 1          // Bottom zone - Whipsaw/Fake signals
        => 3                    // Default to middle zone

// Calculate zone-based Y position
getZoneBasedY(baseY, signalType, isAbove) =>
    if not enableZoneAllocation
        // Use original positioning if zone allocation disabled
        isAbove ? baseY + labelDistance : baseY - labelDistance
    else
        // Get zone number (1-5, where 5 is highest)
        zoneLevel = getSignalZone(signalType)
        
        // Calculate base position from price level
        if isAbove
            // Position above price with zone-based offset
            baseY + labelDistance + (zoneLevel - 3) * zoneSpacing
        else
            // Position below price with zone-based offset  
            baseY - labelDistance - (zoneLevel - 3) * zoneSpacing

// Enhanced function to calculate label Y position with zone allocation and overlap prevention
getLabelY(baseY, isAbove, signalType = "DEFAULT") =>
    float newY = baseY
    float spacing = labelSpacing  // User-configurable spacing between labels
    float baseOffset = labelDistance  // Fixed distance in points from candle
    float proximityRange = maxLabelProximity  // Consider labels within this many bars as potentially overlapping
    bool currentDirection = isAbove  // Local copy that can be modified
    
    // Use zone-based positioning if enabled, otherwise use original method
    if enableZoneAllocation
        newY := getZoneBasedY(baseY, signalType, currentDirection)
    else
        // Original positioning method
        if currentDirection
            newY := baseY + baseOffset
        else
            newY := baseY - baseOffset
    
    // Enhanced overlap prevention - check multiple passes for better spacing
    maxIterations = 8  // More iterations for better resolution
    iteration = 0
    overlapFound = true
    
    while overlapFound and iteration < maxIterations
        overlapFound := false
        iteration := iteration + 1
        
        // Smart distribution: count labels above/below to decide optimal direction
        labelsAbove = 0
        labelsBelow = 0
        if smartDistribution and array.size(recentLabelBars) > 0
            for j = 0 to array.size(recentLabelBars) - 1
                recentBarJ = array.get(recentLabelBars, j)
                recentYJ = array.get(recentLabelYs, j)
                if math.abs(bar_index - recentBarJ) <= proximityRange
                    if recentYJ > baseY
                        labelsAbove := labelsAbove + 1
                    else
                        labelsBelow := labelsBelow + 1
        
        // If too many labels in original direction, consider switching
        if smartDistribution and iteration > 2 and ((currentDirection and labelsAbove > labelsBelow + 2) or (not currentDirection and labelsBelow > labelsAbove + 2))
            currentDirection := not currentDirection
            newY := currentDirection ? baseY + baseOffset : baseY - baseOffset
        
        if array.size(recentLabelBars) > 0
            for i = 0 to array.size(recentLabelBars) - 1
                recentBar = array.get(recentLabelBars, i)
                recentY = array.get(recentLabelYs, i)
                
                // Check if this label is close enough to potentially overlap
                barDistance = math.abs(bar_index - recentBar)
                if barDistance <= proximityRange
                    // Enhanced spacing calculation - moderate increase for same-bar labels
                    proximityFactor = 1.0 - (barDistance / proximityRange)
                    baseSpacing = barDistance == 0 ? spacing * 2.0 : spacing  // 2x spacing for same bar
                    requiredSpacing = baseSpacing * (1.0 + proximityFactor * 1.2)  // 100% to 220% spacing
                    
                    // More aggressive overlap detection and adjustment
                    yDistance = math.abs(newY - recentY)
                    if yDistance < requiredSpacing
                        overlapFound := true
                        
                        // Smart positioning: stack labels efficiently with directional distribution
                        if currentDirection
                            if newY <= recentY
                                newY := recentY + requiredSpacing
                            else
                                // If we're above but too close, move even higher
                                newY := newY + (requiredSpacing - yDistance) * 1.2  // Extra buffer
                        else
                            if newY >= recentY
                                newY := recentY - requiredSpacing
                            else
                                // If we're below but too close, move even lower  
                                newY := newY - (requiredSpacing - yDistance) * 1.2  // Extra buffer
    
    // Store this label's position for future overlap checks
    array.push(recentLabelYs, newY)
    array.push(recentLabelBars, bar_index)
    
    // Keep only recent labels (prevent memory buildup)
    if array.size(recentLabelBars) > maxRecentLabels
        array.shift(recentLabelYs)
        array.shift(recentLabelBars)
    
    newY

// Enhanced function to calculate exit label Y position with overlap prevention
getExitLabelY(baseY, isAbove, signalType = "EXIT") =>
    float newY = baseY
    float spacing = labelSpacing  // User-configurable spacing between labels
    float baseOffset = labelDistance  // Fixed distance in points from candle
    float proximityRange = maxLabelProximity  // Consider labels within this many bars as potentially overlapping
    bool currentDirection = isAbove  // Local copy that can be modified
    
    // Use zone-based positioning if enabled, otherwise use original method
    if enableZoneAllocation
        newY := getZoneBasedY(baseY, signalType, currentDirection)
    else
        // Original positioning method
        if currentDirection
            newY := baseY + baseOffset
        else
            newY := baseY - baseOffset
    
    // Enhanced overlap prevention - check multiple passes for better spacing
    maxIterations = 8  // More iterations for better resolution
    iteration = 0
    overlapFound = true
    
    while overlapFound and iteration < maxIterations
        overlapFound := false
        iteration := iteration + 1
        
        // Smart distribution: count labels above/below to decide optimal direction
        labelsAbove = 0
        labelsBelow = 0
        if smartDistribution and array.size(recentExitLabelBars) > 0
            for j = 0 to array.size(recentExitLabelBars) - 1
                recentBarJ = array.get(recentExitLabelBars, j)
                recentYJ = array.get(recentExitLabelYs, j)
                if math.abs(bar_index - recentBarJ) <= proximityRange
                    if recentYJ > baseY
                        labelsAbove := labelsAbove + 1
                    else
                        labelsBelow := labelsBelow + 1
        
        // If too many labels in original direction, consider switching
        if smartDistribution and iteration > 2 and ((currentDirection and labelsAbove > labelsBelow + 2) or (not currentDirection and labelsBelow > labelsAbove + 2))
            currentDirection := not currentDirection
            newY := currentDirection ? baseY + baseOffset : baseY - baseOffset
        
        // Check for overlaps with other exit labels
        if array.size(recentExitLabelBars) > 0
            for i = 0 to array.size(recentExitLabelBars) - 1
                recentBar = array.get(recentExitLabelBars, i)
                recentY = array.get(recentExitLabelYs, i)
                
                // Check if this label is close enough to potentially overlap
                barDistance = math.abs(bar_index - recentBar)
                if barDistance <= proximityRange
                    // Enhanced spacing calculation - moderate increase for same-bar labels
                    proximityFactor = 1.0 - (barDistance / proximityRange)
                    baseSpacing = barDistance == 0 ? spacing * 2.0 : spacing  // 2x spacing for same bar
                    requiredSpacing = baseSpacing * (1.0 + proximityFactor * 1.2)  // 100% to 220% spacing
                    
                    // More aggressive overlap detection and adjustment
                    yDistance = math.abs(newY - recentY)
                    if yDistance < requiredSpacing
                        overlapFound := true
                        
                        // Smart positioning: stack labels efficiently with directional distribution
                        if currentDirection
                            if newY <= recentY
                                newY := recentY + requiredSpacing
                            else
                                // If we're above but too close, move even higher
                                newY := newY + (requiredSpacing - yDistance) * 1.2  // Extra buffer
                        else
                            if newY >= recentY
                                newY := recentY - requiredSpacing
                            else
                                // If we're below but too close, move even lower  
                                newY := newY - (requiredSpacing - yDistance) * 1.2  // Extra buffer
        
        // Also check for overlaps with entry labels to prevent conflicts
        if array.size(recentLabelBars) > 0
            for i = 0 to array.size(recentLabelBars) - 1
                recentBar = array.get(recentLabelBars, i)
                recentY = array.get(recentLabelYs, i)
                
                // Check if this label is close enough to potentially overlap
                barDistance = math.abs(bar_index - recentBar)
                if barDistance <= proximityRange
                    proximityFactor = 1.0 - (barDistance / proximityRange)
                    baseSpacing = barDistance == 0 ? spacing * 2.5 : spacing * 1.5  // Extra spacing vs entry labels
                    requiredSpacing = baseSpacing * (1.0 + proximityFactor * 1.2)
                    
                    yDistance = math.abs(newY - recentY)
                    if yDistance < requiredSpacing
                        overlapFound := true
                        
                        // Push exit labels further away from entry labels
                        if currentDirection
                            if newY <= recentY
                                newY := recentY + requiredSpacing
                            else
                                newY := newY + (requiredSpacing - yDistance) * 1.3
                        else
                            if newY >= recentY
                                newY := recentY - requiredSpacing
                            else
                                newY := newY - (requiredSpacing - yDistance) * 1.3
    
    // Store this exit label's position for future overlap checks
    array.push(recentExitLabelYs, newY)
    array.push(recentExitLabelBars, bar_index)
    
    // Keep only recent exit labels (prevent memory buildup)
    if array.size(recentExitLabelBars) > maxRecentExitLabels
        array.shift(recentExitLabelYs)
        array.shift(recentExitLabelBars)
    
    newY

// Centralized function for all visual representations with tooltip
drawSignalLabel(barIndex, price, labelText, labelColor, isAbove, tooltip = "", signalType = "DEFAULT") =>
    labelY = getLabelY(price, isAbove, signalType)
    // Use label_up style for green labels, label_down for others
    labelStyle = labelColor == color.green ? label.style_label_up : label.style_label_down
    label.new(barIndex, labelY, labelText, color=labelColor, style=labelStyle, textcolor=color.white, size=size.small, tooltip=tooltip)
    
    // Enhanced connection line from label to trigger price with gap
    // Add user-configurable gap from the actual high/low
    connectionEndPoint = isAbove ? price + connectionGap : price - connectionGap
    line.new(barIndex, labelY, barIndex, connectionEndPoint, color=labelColor, width=1, style=line.style_dashed)
    
    labelY

// ============================================================================
// EXIT DETECTION LOGIC (Target Achievement)
// ============================================================================

// Function to create exit markers matching trading signal label style EXACTLY
createExitMarker(signalType, exitStatus, isShortTrade, target, stop, pnl) =>
    // Determine exit marker properties
    isTargetHit = str.contains(exitStatus, "Target Hit")
    isEODHit = str.contains(exitStatus, "EOD Hit")
    
    // Create exit label text matching signal style
    exitSuffix = if isEODHit
        " EOD"
    else if isTargetHit
        " TGT"
    else
        " SL"
    
    exitLabelText = signalType + exitSuffix
    
    // Set colors: Green for Target, Red for Stop Loss, Orange for EOD
    labelColor = if isEODHit
        color.orange
    else if isTargetHit
        color.green
    else
        color.red
    
    // Enhanced tooltip with trade details
    exitPrice = if isEODHit
        close
    else if isTargetHit
        target
    else
        stop
    
    pnlText = pnl > 0 ? "+" + str.tostring(pnl, "#.#") : str.tostring(pnl, "#.#")
    
    exitTypeText = if isEODHit
        "End of Day (15:30)"
    else if isTargetHit
        "Target Hit"
    else
        "Stop Loss Hit"
    
    tooltipText = signalType + " EXIT\n" + 
                  "Exit Type: " + exitTypeText + "\n" + 
                  "Exit Price: " + str.tostring(exitPrice, "#.##") + "\n" +
                  "P&L: " + pnlText + " points\n" +
                  "Exit Time: " + getCurrentTimeString()
    
    // CRITICAL FIX: Use EXACT same positioning logic as entry signals
    // Short trades: position above using high, Long trades: position below using low
    signalTypeForPositioning = if str.contains(signalType, "ORB")
        "ORB"
    else if str.contains(signalType, "TRAP")
        "TRAP" 
    else if str.contains(signalType, "CONS")
        "CONS"
    else if str.contains(signalType, "WHIPSAW")
        "WHIPSAW"
    else
        "EXIT"
    
    // Declare variables that will be set based on trade direction
    labelY = 0.0
    labelStyle = label.style_label_down
    connectionEndPoint = 0.0
    
    if isShortTrade
        // SHORT EXIT: Position above price like "ORB SHORT" entry signal
        labelY := getLabelY(high, true, signalTypeForPositioning)
        labelStyle := label.style_label_down
        connectionEndPoint := high - connectionGap
    else
        // LONG EXIT: Position below price like "ORB LONG" entry signal
        labelY := getLabelY(low, false, signalTypeForPositioning)
        labelStyle := label.style_label_up
        connectionEndPoint := low + connectionGap
    
    // Create exit label using SAME pattern as entry signals
    exitLabel = label.new(bar_index, labelY, exitLabelText, 
                         color=labelColor,
                         style=labelStyle, 
                         textcolor=color.white, 
                         size=size.small,
                         tooltip=tooltipText)
    
    // Add connection line using SAME pattern as entry signals
    line.new(bar_index, labelY, bar_index, connectionEndPoint, 
             color=labelColor, 
             width=1, 
             style=line.style_dashed)

// Helper function to get current time string


// NOTE: Legacy individual signal exit detection disabled
// Now using unified array-based exit detection system for all trade table entries
// This prevents duplicate exit markers from appearing

// NOTE: Consolidation and Fake Breakout exit detection disabled - using array-based system

// Whipsaw LONG dynamic updates
if whipsawLongTriggered and whipsawLongExitStatus == ""
    if high >= whipsawLongTarget
        whipsawLongExitStatus := "Target Hit"
        whipsawLongExitTime := getCurrentTimeString()
    else if low <= whipsawLongStop
        whipsawLongExitStatus := "SL Hit"
        whipsawLongExitTime := getCurrentTimeString()

// Whipsaw SHORT dynamic updates
if whipsawShortTriggered and whipsawShortExitStatus == ""
    if low <= whipsawShortTarget
        whipsawShortExitStatus := "Target Hit"
        whipsawShortExitTime := getCurrentTimeString()
    else if high >= whipsawShortStop
        whipsawShortExitStatus := "SL Hit"
        whipsawShortExitTime := getCurrentTimeString()

