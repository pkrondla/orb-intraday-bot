var int trapPhase = 0  // 0=none, 1=first_counter, 2=consolidation, 3=second_counter, 4=final_move
var float trapHigh = na
var float trapLow = na
var int trapStartBar = 0
var bool bothSidesTrapTriggered = false

// Perfect Entry Variables (50% Retracement)
var float perfectEntryLevel = na
var bool perfectEntryLong = false
var bool perfectEntryShort = false
var bool perfectEntryTriggered = false

// Enhanced Fake Breakout Variables
var bool sustainedBreakout = false
var int breakoutSustainBars = 0
var float lastBreakoutLevel = na
var bool enhancedFakeBreakout = false
var bool enhancedFakeBreakdown = false

// LL/HH Structure Validation Variables
var bool validRiseStructure = false
var bool validFallStructure = false
var int lastLowerLowBar = 0
var int lastHigherHighBar = 0

// Reset ORH/ORL at the start of each trading day
newDay = ta.change(time("1D")) != 0
if newDay
    orh := na
    orl := na
    orhDetermined := false
    orlDetermined := false
    orhBarIndex := 0
    orlBarIndex := 0
    orhLabelDrawn := false
    orlLabelDrawn := false
    // Reset ORB LONG 3-phase tracking
    orhInitialBreakout := false
    orhRetestCompleted := false
    orhRetestLow := 0.0
    orhRetestBar := 0
    // Reset ORB SHORT 3-phase tracking
    orlInitialBreakdown := false
    orlRetestCompleted := false
    orlRetestHigh := 0.0
    orlRetestBar := 0
    // Reset Bear Trap tracking
    bearTrapCandleOccurred := false
    bearTrapCandleHigh := 0.0
    bearTrapCandleBar := 0
    // Reset additional whipsaw tracking for bear trap
    bearTrapAdditionalWhipsaw := false
    bearTrapWhipsawCount := 0
    bearTrapWhipsawTriggered := false
    // Reset additional whipsaw tracking for bull trap
    bullTrapAdditionalWhipsaw := false
    bullTrapWhipsawCount := 0
    bullTrapWhipsawTriggered := false
    // Reset additional whipsaw tracking for ORB Long
    orbLongAdditionalWhipsaw := false
    orbLongWhipsawCount := 0
    orbLongWhipsawTriggered := false
    // Reset additional whipsaw tracking for ORB Short
    orbShortAdditionalWhipsaw := false
    orbShortWhipsawCount := 0
    orbShortWhipsawTriggered := false
    // Reset ORB Follow-up Failure patterns
    bullTrapCase1 := false
    bullTrapCase2 := false
    bearTrapCase1 := false
    bearTrapCase2 := false
    bullTrapCase1Entry := 0.0
    bullTrapCase2Entry := 0.0
    bearTrapCase1Entry := 0.0
    bearTrapCase2Entry := 0.0
    bullTrapCase1Stop := 0.0
    bullTrapCase2Stop := 0.0
    bearTrapCase1Stop := 0.0
    bearTrapCase2Stop := 0.0
    bullTrapCase1Target := 0.0
    bullTrapCase2Target := 0.0
    bearTrapCase1Target := 0.0
    bearTrapCase2Target := 0.0

// Track provisional ORH/ORL during trading session
if isTradingSession()
    // Initialize ORH/ORL from market open price
    if na(orh) and na(orl)
        orh := open  // Start from opening price
        orl := open  // Start from opening price
        orhBarIndex := bar_index
        orlBarIndex := bar_index
    
    // Provisional ORH: Track highest point until it stops making higher highs
    if not orhDetermined
        if high > orh
            orh := high  // Update to new high
            orhBarIndex := bar_index
    
    // Provisional ORL: Track lowest point until it stops making lower lows
    if not orlDetermined
        if low < orl
            orl := low   // Update to new low
            orlBarIndex := bar_index

// ORH finalization: When price stops making higher highs (3-candle confirmation)
if isTradingSession() and not orhDetermined and bar_index >= 2
    if high < high[1] and high[1] > high[2]
        // Price stopped making higher highs - ORH confirmed at the highest point reached
        orhDetermined := true
        // ORH value already set to the highest point reached, just mark as final

// ORL finalization: When price stops making lower lows (3-candle confirmation)
if isTradingSession() and not orlDetermined and bar_index >= 2
    if low > low[1] and low[1] < low[2]
        // Price stopped making lower lows - ORL confirmed at the lowest point reached
        orlDetermined := true
        // ORL value already set to the lowest point reached, just mark as final

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

// Helper function to get current time string
getCurrentTimeString() =>
    currentHour = hour(time, "Asia/Kolkata")
    currentMinute = minute(time, "Asia/Kolkata") 
    str.tostring(currentHour, "00") + ":" + str.tostring(currentMinute, "00")

// Helper function to calculate optimal target based on ORH/ORL range or nearest pivot
getOptimalTarget(entryPrice, isLong, stopLoss) =>
    var float targetPrice = 0.0
    
    // Option 1: Use ORH/ORL range distance if both are determined
    if orhDetermined and orlDetermined
        rangeOR = orh - orl
        if isLong
            targetPrice := entryPrice + rangeOR
        else
            targetPrice := entryPrice - rangeOR
    else
        // Option 2: Use nearest pivot target
        if isLong
            // For LONG: Find nearest resistance (R1, R2, etc.) above entry
            if entryPrice < r1
                targetPrice := r1
            else if entryPrice < r2
                targetPrice := r2
            else if entryPrice < r3
                targetPrice := r3
            else
                // Fallback: Use ORH if available or 1:1 R:R
                targetPrice := orhDetermined ? orh : entryPrice + (entryPrice - stopLoss)
        else
            // For SHORT: Find nearest support (S1, S2, etc.) below entry
            if entryPrice > s1
                targetPrice := s1
            else if entryPrice > s2
                targetPrice := s2
            else if entryPrice > s3
                targetPrice := s3
            else
                // Fallback: Use ORL if available or 1:1 R:R
                targetPrice := orlDetermined ? orl : entryPrice - (stopLoss - entryPrice)
    
    targetPrice

// ============================================================================
// PIVOT ZONE ENHANCEMENT FUNCTIONS
// ============================================================================

// Get current market zone based on pivot levels
getCurrentZone() =>
    if close > r1
        "bullish"
    else if close < s1
        "bearish"
    else
        "neutral"

// Check if signal is valid for current zone
isValidZoneForSignal(signalType) =>
    zone = getCurrentZone()
    result = false
    
    if zone == "bullish" // Above R1 - Only bullish trades allowed
        result := signalType == "ORB_LONG" or signalType == "BEAR_TRAP" or signalType == "BEAR_TRAP_C1" or signalType == "BEAR_TRAP_C2" or signalType == "CONS_LONG" or signalType == "CONS_FAKE_BD"
    else if zone == "bearish" // Below S1 - Only bearish trades allowed
        result := signalType == "ORB_SHORT" or signalType == "BULL_TRAP" or signalType == "BULL_TRAP_C1" or signalType == "BULL_TRAP_C2" or signalType == "FAILED_BEAR_TRAP" or signalType == "CONS_SHORT" or signalType == "CONS_FAKE_BO"
    else if zone == "neutral" // R1-P-S1 - Conservative trades only (Scalp & Run)
        result := signalType == "ORB_LONG" or signalType == "ORB_SHORT" or signalType == "CONS_FAKE_BD" or signalType == "CONS_FAKE_BO"
    
    result

// Get trade emphasis based on zone
getTradeEmphasis() =>
    zone = getCurrentZone()
    result = "Unknown Zone"
    
    if zone == "bullish"
        if close >= r1 and close <= r2
            result := "🚀 AGGRESSIVE BULLISH - Don't Miss!"
        else
            result := "Standard Bullish"
    else if zone == "bearish"
        if close <= s1 and close >= s2
            result := "🚀 AGGRESSIVE BEARISH - Don't Miss!"
        else
            result := "Standard Bearish"
    else if zone == "neutral"
        result := "📊 SCALP & RUN MODE"
    
    result

// Generate sequential targets for multi-target system
getTargetSequence(entryPrice, isLong) =>
    targets = array.new<float>()
    
    if isLong
        // Target 1: ORH (if available and above entry)
        if orhDetermined and orh > entryPrice
            array.push(targets, orh)
        
        // Target 2-4: Pivot progression based on zone
        zone = getCurrentZone()
        if zone == "bullish"
            // Aggressive targeting in bullish zone
            if entryPrice < r1
                array.push(targets, r1)
            if entryPrice < r2
                array.push(targets, r2)
            if entryPrice < r3
                array.push(targets, r3)
        else
            // Conservative targeting
            if entryPrice < r1
                array.push(targets, r1)
            if entryPrice < r2
                array.push(targets, r2)
    else
        // Target 1: ORL (if available and below entry)
        if orlDetermined and orl < entryPrice
            array.push(targets, orl)
        
        // Target 2-4: Pivot progression based on zone
        zone = getCurrentZone()
        if zone == "bearish"
            // Aggressive targeting in bearish zone
            if entryPrice > s1
                array.push(targets, s1)
            if entryPrice > s2
                array.push(targets, s2)
            if entryPrice > s3
                array.push(targets, s3)
        else
            // Conservative targeting
            if entryPrice > s1
                array.push(targets, s1)
            if entryPrice > s2
                array.push(targets, s2)
    
    targets

// Check for mandatory exits at critical levels
checkMandatoryExits() =>
    exitTriggered = false
    reason = ""
    
    // R2/R3 exits for any long positions (using available pivot levels)
    if high >= r2 and not na(r2)
        exitTriggered := true
        reason := "R2 RESISTANCE HIT"
    else if high >= r3 and not na(r3)
        exitTriggered := true
        reason := "R3 RESISTANCE HIT"
    
    // S2/S3 exits for any short positions  
    if low <= s2 and not na(s2)
        exitTriggered := true
        reason := "S2 SUPPORT HIT"
    else if low <= s3 and not na(s3)
        exitTriggered := true
        reason := "S3 SUPPORT HIT"
    
    [exitTriggered, reason]

// ============================================================================
// ENHANCED WHIPSAW & MINOR PRICE ACTION FUNCTIONS
// ============================================================================

// Enhanced consolidation detection with multiple touches
// Note: Converted from function to direct execution to allow global variable modification

// Validate LL/HH structure rules - "Every Rise Must Have At Least One Lower Low"
// Note: Converted from function to direct execution to allow global variable modification

// Enhanced fake breakout validation with sustainability check
validateBreakout(level, direction, sustainBars) =>
    isSustained = true
    
    if direction == "bullish"
        // Check if breakout above level sustains
        for i = 0 to sustainBars
            if high[i] <= level
                isSustained := false
                break
    else
        // Check if breakdown below level sustains  
        for i = 0 to sustainBars
            if low[i] >= level
                isSustained := false
                break
    
    isSustained

// Calculate perfect entry level (50% retracement)
calculatePerfectEntry(highLevel, lowLevel, patternDirection) =>
    midPoint = (highLevel + lowLevel) / 2
    entryLevel = 0.0  // Initialize with float type
    
    if patternDirection == "bullish_reversal"
        // Entry above midpoint after fake breakdown
        entryLevel := lowLevel + (highLevel - lowLevel) * 0.618  // Golden ratio
    else if patternDirection == "bearish_reversal"
        // Entry below midpoint after fake breakout
        entryLevel := highLevel - (highLevel - lowLevel) * 0.618  // Golden ratio
    
    entryLevel

// ============================================================================
// ORB ENTRY CONDITIONS with Enhanced Confirmation
// ============================================================================

var bool orhBreakoutTriggered = false
var bool orlBreakoutTriggered = false
var float orhBreakoutHigh = 0.0
var int orhBreakoutBar = 0

var float orlBreakoutLow = 0.0
var int orlBreakoutBar = 0

// ORB conditions
orbLongCondition = false
orbShortCondition = false

// ORB LONG: 3-Phase Process as per Setup Instructions
// Phase 1: Initial Breakout - Candle closes above ORH
if orhDetermined and close > orh and close[1] <= orh and not orhInitialBreakout and not orbLongCondition
    orhInitialBreakout := true
    orhBreakoutTriggered := true  // For ORH BO triangle display
    orhBreakoutHigh := high  // Store ORB candle high for Phase 3 comparison
    orhBreakoutBar := bar_index  // Store ORB candle bar index

// Phase 2: Retest - Price comes down and retests ORH
if orhInitialBreakout and not orhRetestCompleted and low <= orh and close > orh
    orhRetestCompleted := true
    orhRetestLow := low
    orhRetestBar := bar_index

// Phase 3: Confirmation - Price makes higher high than original ORB candle
if orhRetestCompleted and not orbLongCondition and high > orhBreakoutHigh
    // ORB LONG Signal: Enter at low of confirmation candle (as per setup instructions)
    orbLongCondition := true
    orbLongEntry := low  // Entry at low of confirmation candle
    
    // Dynamic ATR-based stop loss with ORH level comparison
    orbLevel = orhDetermined ? orh : na
    [dynamicStop, atrDistance, atrValue, multiplier] = calculateDynamicStop(orbLongEntry, "ORB_LONG", true, orbLevel)
    orbLongStop := dynamicStop
    
    // Use optimal target: ORH/ORL range or nearest pivot
    orbLongTarget := getOptimalTarget(orbLongEntry, true, orbLongStop)
    // Track for trending day detection
    if not hasORHBreakout
        hasORHBreakout := true
        bullishSetupCount += 1

// ORB SHORT: 3-Phase Process as per Setup Instructions  
// Phase 1: Initial Breakdown - Candle closes below ORL
if orlDetermined and close < orl and close[1] >= orl and not orlInitialBreakdown and not orbShortCondition
    orlInitialBreakdown := true
    orlBreakoutTriggered := true  // For ORL BO triangle display
    orlBreakoutLow := low  // Store ORB candle low for Phase 3 comparison
    orlBreakoutBar := bar_index  // Store ORB candle bar index

// Phase 2: Retest - Price comes up and retests ORL
if orlInitialBreakdown and not orlRetestCompleted and high >= orl and close < orl
    orlRetestCompleted := true
    orlRetestHigh := high
    orlRetestBar := bar_index

// Phase 3: Confirmation - Price makes lower low than original ORB candle
if orlRetestCompleted and not orbShortCondition and low < orlBreakoutLow
    // ORB SHORT Signal: Enter at high of confirmation candle (as per setup instructions)
    orbShortCondition := true
    orbShortEntry := high  // Entry at high of confirmation candle
    
    // Dynamic ATR-based stop loss with ORL level comparison
    orbLevel = orlDetermined ? orl : na
    [dynamicStop, atrDistance, atrValue, multiplier] = calculateDynamicStop(orbShortEntry, "ORB_SHORT", false, orbLevel)
    orbShortStop := dynamicStop
    
    // Use optimal target: ORH/ORL range or nearest pivot
    orbShortTarget := getOptimalTarget(orbShortEntry, false, orbShortStop)
    // Track for trending day detection
    if not hasORLBreakdown
        hasORLBreakdown := true
        bearishSetupCount += 1

// ============================================================================
// ORB FOLLOW-UP FAILURE PATTERNS (Case 1 & Case 2)
// ============================================================================

// BULL TRAP CASE 1: No Confirmation Candle - ORB breakout without retest becomes trap
// Immediate failure after ORH breakout without retest phase
if orhDetermined and orhInitialBreakout and not orhRetestCompleted and not bullTrapCase1 and not orbLongCondition
    if close < orh  // Price closes back below ORH without completing retest
        bullTrapCase1 := true
        bullTrapCase1Entry := close  // Aggressive entry at close below ORH
        // SL: ORH or 35 points (whichever is closer)
        slAtORH = orh
        sl35Points = bullTrapCase1Entry + niftyStopLoss
        bullTrapCase1Stop := math.min(slAtORH, sl35Points)
        // Target: ORL as per setup specifications
        bullTrapCase1Target := orl
        // Track for trending day detection
        if not hasFailedBullTrap
            hasFailedBullTrap := true
            bearishSetupCount += 1

// BULL TRAP CASE 2: Confirmation Came But Follow-up Failed 
// Full ORB process completed but momentum died after confirmation
if orbLongCondition and not bullTrapCase2
    if close < orh  // Price closes back below ORH after full ORB process
        bullTrapCase2 := true
        bullTrapCase2Entry := close  // Aggressive entry at close below ORH
        // SL: ORH or 35 points (whichever is closer)
        slAtORH = orh
        sl35Points = bullTrapCase2Entry + niftyStopLoss
        bullTrapCase2Stop := math.min(slAtORH, sl35Points)
        // Target: ORL as per setup specifications
        bullTrapCase2Target := orl
        // Track for trending day detection (only count once per day)
        if not hasFailedBullTrap
            hasFailedBullTrap := true
            bearishSetupCount += 1

// BEAR TRAP CASE 1: No Confirmation Candle - ORB breakdown without retest becomes trap
// Immediate failure after ORL breakdown without retest phase
if orlDetermined and orlInitialBreakdown and not orlRetestCompleted and not bearTrapCase1 and not orbShortCondition
    if close > orl  // Price closes back above ORL without completing retest
        bearTrapCase1 := true
        bearTrapCase1Entry := close  // Aggressive entry at close above ORL
        // SL: ORL or 35 points (whichever is closer)
        slAtORL = orl
        sl35Points = bearTrapCase1Entry - niftyStopLoss
        bearTrapCase1Stop := math.max(slAtORL, sl35Points)
        // Target: ORH as per setup specifications
        bearTrapCase1Target := orh
        // Track for trending day detection
        if not hasFailedBearTrap
            hasFailedBearTrap := true
            bullishSetupCount += 1

// BEAR TRAP CASE 2: Confirmation Came But Follow-up Failed
// Full ORB process completed but momentum died after confirmation
if orbShortCondition and not bearTrapCase2
    if close > orl  // Price closes back above ORL after full ORB process
        bearTrapCase2 := true
        bearTrapCase2Entry := close  // Aggressive entry at close above ORL
        // SL: ORL or 35 points (whichever is closer)
        slAtORL = orl
        sl35Points = bearTrapCase2Entry - niftyStopLoss
        bearTrapCase2Stop := math.max(slAtORL, sl35Points)
        // Target: ORH as per setup specifications
        bearTrapCase2Target := orh
        // Track for trending day detection (only count once per day)
        if not hasFailedBearTrap
            hasFailedBearTrap := true
            bullishSetupCount += 1

// ============================================================================
// BULL/BEAR TRAP DETECTION
// ============================================================================

// Track Bull Trap sequence: ORH BO → Bull Trap Candle → Confirmation
var bool bullTrapCandleOccurred = false
var float bullTrapCandleLow = 0.0
var int bullTrapCandleBar = 0

bullTrapCondition = false
var float bullTrapEntry = 0.0
var float bullTrapStop = 0.0
var float bullTrapTarget = 0.0

if orhDetermined and orlDetermined and isTradingSession() and not isORBPeriod()
    // Step 1: Detect Bull Trap Candle (after ORH BO, candle closes below ORH)
    if orhBreakoutTriggered and close < orh and not bullTrapCandleOccurred
        bullTrapCandleOccurred := true
        bullTrapCandleLow := low  // Store the low of bull trap candle
        bullTrapCandleBar := bar_index
    
    // Step 2: Detect Confirmation (candle breaks previous swing low after bull trap candle)
    if bullTrapCandleOccurred and bar_index > bullTrapCandleBar and low < bullTrapCandleLow
        bullTrapCondition := true
        bullTrapEntry := low
        // SL: ORH or 35 Points (whichever is closer)
        slAtORH = orh
        sl35Points = close + niftyStopLoss
        bullTrapStop := math.min(slAtORH, sl35Points)
        // Target: ORL as per setup specifications
        bullTrapTarget := orl
        // Track for trending day detection
        if not hasBullTrap
            hasBullTrap := true
            bearishSetupCount += 1

// Bear Trap: 2-Step Sequential Process (similar to Bull Trap)
bearTrapCondition = false
var float bearTrapEntry = 0.0
var float bearTrapStop = 0.0
var float bearTrapTarget = 0.0

if orlDetermined and orhDetermined and isTradingSession() and not isORBPeriod()
    // Step 1: Detect Bear Trap Candle (after ORL BD, candle closes above ORL)
    if orlBreakoutTriggered and close > orl and not bearTrapCandleOccurred
        bearTrapCandleOccurred := true
        bearTrapCandleHigh := high  // Store the high of bear trap candle
        bearTrapCandleBar := bar_index
    
    // Step 2: Detect Confirmation (candle breaks previous swing high after bear trap candle)
    if bearTrapCandleOccurred and bar_index > bearTrapCandleBar and high > bearTrapCandleHigh
        bearTrapCondition := true
        bearTrapEntry := high
        // SL: ORL or 35 Points (whichever is closer)
        slAtORL = orl
        sl35Points = close - niftyStopLoss
        bearTrapStop := math.max(slAtORL, sl35Points)
        // Target: ORH as per setup specifications
        bearTrapTarget := orh
        // Track for trending day detection
        if not hasBearTrap
            hasBearTrap := true
            bullishSetupCount += 1

// Additional Whipsaw Detection for Bear Trap (after initial bear trap confirmation)
if bearTrapCondition and not bearTrapAdditionalWhipsaw
    // Count additional rejections at ORL after bear trap
    if low <= orl and close > orl and bearTrapWhipsawCount < 3  // Limit to 3 additional whipsaws
        bearTrapWhipsawCount := bearTrapWhipsawCount + 1
        // Trigger additional whipsaw signal after 2nd rejection
        if bearTrapWhipsawCount >= 2 and not bearTrapWhipsawTriggered
            bearTrapAdditionalWhipsaw := true

// Additional Whipsaw Detection for Bull Trap (after initial bull trap confirmation)
if bullTrapCondition and not bullTrapAdditionalWhipsaw
    // Count additional rejections at ORH after bull trap
    if high >= orh and close < orh and bullTrapWhipsawCount < 3  // Limit to 3 additional whipsaws
        bullTrapWhipsawCount := bullTrapWhipsawCount + 1
        // Trigger additional whipsaw signal after 2nd rejection
        if bullTrapWhipsawCount >= 2 and not bullTrapWhipsawTriggered
            bullTrapAdditionalWhipsaw := true

// Additional Whipsaw Detection for ORB Long (after initial ORB Long confirmation)
if orbLongCondition and not orbLongAdditionalWhipsaw
    // Count additional retests at ORH that hold as support after ORB Long
    if low <= orh and close > orh and orbLongWhipsawCount < 3  // Limit to 3 additional whipsaws
        orbLongWhipsawCount := orbLongWhipsawCount + 1
        // Trigger additional whipsaw signal after 2nd successful retest
        if orbLongWhipsawCount >= 2 and not orbLongWhipsawTriggered
            orbLongAdditionalWhipsaw := true

// Additional Whipsaw Detection for ORB Short (after initial ORB Short confirmation)
if orbShortCondition and not orbShortAdditionalWhipsaw
    // Count additional retests at ORL that hold as resistance after ORB Short
    if high >= orl and close < orl and orbShortWhipsawCount < 3  // Limit to 3 additional whipsaws
        orbShortWhipsawCount := orbShortWhipsawCount + 1
        // Trigger additional whipsaw signal after 2nd successful rejection
        if orbShortWhipsawCount >= 2 and not orbShortWhipsawTriggered
            orbShortAdditionalWhipsaw := true

// ============================================================================
// CONSOLIDATION BREAKOUT DETECTION
// ============================================================================

// Track rejections at ORH/ORL
var orhRejections = 0
var orlRejections = 0
var lastRejectionBar = 0

if orhDetermined and orlDetermined and isTradingSession() and not isORBPeriod()
    // Count rejections
    if high >= orh and close < orh
        orhRejections := orhRejections + 1
        lastRejectionBar := bar_index
    
    if low <= orl and close > orl
        orlRejections := orlRejections + 1
        lastRejectionBar := bar_index
    
    // Reset rejections if too much time has passed
    if bar_index - lastRejectionBar > 20  // 1 hour on 3-minute chart
        orhRejections := 0
        orlRejections := 0

// ============================================================================
// ENHANCED WHIPSAW & MINOR PRICE ACTION DETECTION  
// ============================================================================

// Enhanced consolidation detection
if isTradingSession() and orhDetermined and orlDetermined
    // Direct consolidation detection logic (converted from function)
    tolerance = syminfo.mintick * 5  // 5 tick tolerance for level matching
    minTouches = 3
    minDuration = 15
    
    // Reset if we're starting fresh
    if not consolidationActive
        consolidationStartBar := bar_index
        consolidationResistance := na
        consolidationSupport := na
        consolidationTouches := 0
    
    consolidationDuration := bar_index - consolidationStartBar
    
    // Look for horizontal levels with multiple touches
    if consolidationDuration >= minDuration
        // Check for resistance level touches
        resistanceTouches = 0
        supportTouches = 0
        
        // Scan recent highs and lows for level formation
        lookback = math.min(consolidationDuration, 50)
        
        for i = 1 to lookback
            // Count resistance touches
            if not na(consolidationResistance)
                if math.abs(high[i] - consolidationResistance) <= tolerance
                    resistanceTouches += 1
            else
                // Establish potential resistance
                recentHigh = ta.highest(high, 10)
                if high[i] >= recentHigh * 0.998  // Within 0.2% of recent high
                    consolidationResistance := recentHigh
                    resistanceTouches := 1
            
            // Count support touches  
            if not na(consolidationSupport)
                if math.abs(low[i] - consolidationSupport) <= tolerance
                    supportTouches += 1
            else
                // Establish potential support
                recentLow = ta.lowest(low, 10)
                if low[i] <= recentLow * 1.002  // Within 0.2% of recent low
                    consolidationSupport := recentLow
                    supportTouches := 1
        
        // Confirm consolidation if we have enough touches
        if resistanceTouches >= minTouches and supportTouches >= minTouches
            consolidationActive := true
            consolidationConfirmed := true
            consolidationTouches := resistanceTouches + supportTouches
    
    // Enhanced fake breakout detection with consolidation
    if consolidationConfirmed and not na(consolidationResistance) and not na(consolidationSupport)
        
        // Detect fake breakout above consolidation resistance
        if high > consolidationResistance and not enhancedFakeBreakout
            sustainedBreakout := validateBreakout(consolidationResistance, "bullish", 3)
            
            if not sustainedBreakout and close <= consolidationResistance
                enhancedFakeBreakout := true
                lastBreakoutLevel := consolidationResistance
                
                // Calculate perfect entry for short
                perfectEntryLevel := calculatePerfectEntry(consolidationResistance, consolidationSupport, "bearish_reversal")
                perfectEntryShort := true
        
        // Detect fake breakdown below consolidation support  
        if low < consolidationSupport and not enhancedFakeBreakdown
            sustainedBreakdown = validateBreakout(consolidationSupport, "bearish", 3)
            
            if not sustainedBreakdown and close >= consolidationSupport
                enhancedFakeBreakdown := true
                lastBreakoutLevel := consolidationSupport
                
                // Calculate perfect entry for long
                perfectEntryLevel := calculatePerfectEntry(consolidationResistance, consolidationSupport, "bullish_reversal")
                perfectEntryLong := true

// Enhanced LL/HH structure validation
if isTradingSession()
    // Validate structure for ORB Long signals - only proceed if structure is valid
    if orbLongCondition
        // Check if rise has at least one lower low
        hasLowerLow = false
        lookbackPeriod = 20
        priceRising = close > close[lookbackPeriod]
        
        if priceRising
            for i = 1 to lookbackPeriod
                if low[i] < low[i+1] and low[i] < low[i-1]  // Swing low
                    hasLowerLow := true
                    lastLowerLowBar := bar_index - i
                    break
        
        validRiseStructure := hasLowerLow
    
    // Validate structure for ORB Short signals
    if orbShortCondition  
        // Check if fall has at least one higher high
        hasHigherHigh = false
        lookbackPeriod = 20
        priceFalling = close < close[lookbackPeriod]
        
        if priceFalling
            for i = 1 to lookbackPeriod
                if high[i] > high[i+1] and high[i] > high[i-1]  // Swing high
                    hasHigherHigh := true
                    lastHigherHighBar := bar_index - i
                    break
        
        validFallStructure := hasHigherHigh

// Both Sides Trap Pattern Detection
if isTradingSession() and orhDetermined and orlDetermined
    
    // Phase 1: Detect initial trend with counter-move (first trap)
    if trapPhase == 0
        // Look for initial trend direction
        recentTrend = close > close[10] ? "up" : "down"
        
        if recentTrend == "down"
            // Look for counter-move up (first trap - bulls)
            if close > ta.highest(high, 5) and close > close[5]
                trapPhase := 1
                trapHigh := high
                trapLow := ta.lowest(low, 10)
                trapStartBar := bar_index
        else
            // Look for counter-move down (first trap - bears)  
            if close < ta.lowest(low, 5) and close < close[5]
                trapPhase := 1
                trapHigh := ta.highest(high, 10)
                trapLow := low
                trapStartBar := bar_index
    
    // Phase 2: Detect consolidation phase
    else if trapPhase == 1 and (bar_index - trapStartBar) > 10
        if consolidationConfirmed
            trapPhase := 2
    
    // Phase 3: Detect second counter-move (second trap)
    else if trapPhase == 2 and consolidationConfirmed
        if not na(trapHigh) and not na(trapLow)
            // Look for second counter-move
            if close > consolidationResistance * 0.999 or close < consolidationSupport * 1.001
                trapPhase := 3
    
    // Phase 4: Detect final explosive move
    else if trapPhase == 3
        rangeSize = trapHigh - trapLow
        
        // Look for final move beyond both trap levels
        if high > trapHigh + rangeSize * 0.5 or low < trapLow - rangeSize * 0.5
            trapPhase := 4
            bothSidesTrapActive := true

// Consolidation breakout conditions (only if ORH/ORL determined)
consolidationBreakoutLong = orhDetermined and orhRejections >= 3 and close > orh
consolidationBreakoutShort = orlDetermined and orlRejections >= 3 and close < orl

// Consolidation Breakout entry/exit calculations
var float consBreakoutLongEntry = 0.0
var float consBreakoutLongStop = 0.0
var float consBreakoutLongTarget = 0.0
var float consBreakoutShortEntry = 0.0
var float consBreakoutShortStop = 0.0
var float consBreakoutShortTarget = 0.0

if consolidationBreakoutLong
    consBreakoutLongEntry := high  // Direct entry at high to catch maximum momentum
    consBreakoutLongStop := math.max((orlDetermined ? orl : consBreakoutLongEntry - niftyStopLoss), consBreakoutLongEntry - niftyStopLoss)
    // Use ORH/ORL range distance or nearest pivot target as per setup
    consBreakoutLongTarget := getOptimalTarget(consBreakoutLongEntry, true, consBreakoutLongStop)

if consolidationBreakoutShort
    consBreakoutShortEntry := close  // Direct entry at close as per setup - NO retest
    consBreakoutShortStop := math.max((orhDetermined ? orh : consBreakoutShortEntry + niftyStopLoss), consBreakoutShortEntry + niftyStopLoss)
    // Use ORH/ORL range distance or nearest pivot target as per setup
    consBreakoutShortTarget := getOptimalTarget(consBreakoutShortEntry, false, consBreakoutShortStop)

// ============================================================================
// WHIPSAW PATTERN DETECTION
// ============================================================================

// Track swing highs and lows with enhanced detection
var swingHigh = 0.0
var swingLow = 0.0
var llCount = 0
var hhCount = 0
var lastSwingDirection = 0  // 1 for HH, -1 for LL
var whipsawConfirmationBars = 0

// Enhanced swing tracking for precise whipsaw detection (using pivot-based swing identification)
if isTradingSession()
    // Detect swing highs (3-bar pattern: previous bar higher than both current and 2 bars ago)
    isSwingHigh = high[1] > high and high[1] > high[2] and bar_index > 2
    
    // Detect swing lows (3-bar pattern: previous bar lower than both current and 2 bars ago)  
    isSwingLow = low[1] < low and low[1] < low[2] and bar_index > 2
    
    // Track consecutive higher highs (each new swing high is higher than previous)
    if isSwingHigh
        currentSwingHigh = high[1]
        if currentSwingHigh > swingHigh or swingHigh == 0.0
            swingHigh := currentSwingHigh
            if lastSwingDirection != 1  // Direction change to HH
                hhCount := 1
            else
                hhCount := hhCount + 1
            lastSwingDirection := 1
            llCount := 0  // Reset LL count when we get HH
            whipsawConfirmationBars := 0
    
    // Track consecutive lower lows (each new swing low is lower than previous)
    if isSwingLow
        currentSwingLow = low[1] 
        if currentSwingLow < swingLow or swingLow == 0.0
            swingLow := currentSwingLow
            if lastSwingDirection != -1  // Direction change to LL
                llCount := 1
            else
                llCount := llCount + 1
            lastSwingDirection := -1
            hhCount := 0  // Reset HH count when we get LL
            whipsawConfirmationBars := 0
    
    // Count bars since last swing formation for confirmation
    whipsawConfirmationBars := whipsawConfirmationBars + 1

// Whipsaw pattern identification
twoLL = llCount >= 2
threeLL = llCount >= 3
twoHH = hhCount >= 2
threeHH = hhCount >= 3

// Pattern change detection for circle indicators (fixed logic)
twoLLNew = twoLL and not twoLL[1]
threeLLNew = threeLL and not threeLL[1] and not twoLLNew  // Show 3LL only if it's new and 2LL didn't just trigger
twoHHNew = twoHH and not twoHH[1]  
threeHHNew = threeHH and not threeHH[1] and not twoHHNew  // Show 3HH only if it's new and 2HH didn't just trigger

// ============================================================================
// FAKE BREAKOUT/BREAKDOWN DETECTION
// ============================================================================

// Track fake breakouts at key levels
var fakeBreakoutAboveORH = false
var fakeBreakdownBelowORL = false
var consolidationPhase = false

// Detect fake breakouts (breakout followed by immediate reversal)
if orhDetermined and orlDetermined and isTradingSession()
    // Check for consolidation phase (multiple rejections)
    consolidationPhase := orhRejections >= 2 or orlRejections >= 2
    
    // Fake breakout above ORH (goes above then immediately reverses)
    if high > orh and close < orh and high[1] <= orh
        fakeBreakoutAboveORH := true
    
    // Fake breakdown below ORL (goes below then immediately reverses)  
    if low < orl and close > orl and low[1] >= orl
        fakeBreakdownBelowORL := true

// ============================================================================
// WHIPSAW-BASED ENTRY CONDITIONS
// ============================================================================

// Whipsaw Long Entry (after 2LL/3LL pattern)
whipsawLongCondition = false
whipsawLongEntry = 0.0
whipsawLongStop = 0.0
whipsawLongTarget = 0.0

if isTradingSession() and not isORBPeriod()
    // Entry after 2LL or 3LL when price breaks above recent swing high
    if (twoLL or threeLL) and close > swingHigh and whipsawConfirmationBars >= 2
        whipsawLongCondition := true
        whipsawLongEntry := high
        whipsawLongStop := math.max(swingLow, close - niftyStopLoss)
        // Use optimal target: ORH/ORL range or nearest pivot
        whipsawLongTarget := getOptimalTarget(whipsawLongEntry, true, whipsawLongStop)

// Whipsaw Short Entry (after 2HH/3HH pattern)  
whipsawShortCondition = false
whipsawShortEntry = 0.0
whipsawShortStop = 0.0
whipsawShortTarget = 0.0

if isTradingSession() and not isORBPeriod()
    // Entry after 2HH or 3HH when price breaks below recent swing low
    if (twoHH or threeHH) and close < swingLow and whipsawConfirmationBars >= 2
        whipsawShortCondition := true
        whipsawShortEntry := low
        whipsawShortStop := math.min(swingHigh, close + niftyStopLoss)
        // Use optimal target: ORH/ORL range or nearest pivot
        whipsawShortTarget := getOptimalTarget(whipsawShortEntry, false, whipsawShortStop)

// Fake Breakout Reversal Long (Consolidation + Fake Breakdown = Sharp Move Up)
fakeBreakoutLongCondition = false
var float fakeBreakoutLongEntry = 0.0
var float fakeBreakoutLongStop = 0.0
var float fakeBreakoutLongTarget = 0.0

if orlDetermined and consolidationPhase and fakeBreakdownBelowORL
    // Sharp move up after fake breakdown
    if close > orl and close > high[1]
        fakeBreakoutLongCondition := true
        fakeBreakoutLongEntry := high
        fakeBreakoutLongStop := orl
        // Use optimal target: ORH/ORL range or nearest pivot
        fakeBreakoutLongTarget := getOptimalTarget(fakeBreakoutLongEntry, true, fakeBreakoutLongStop)

// Fake Breakdown Reversal Short (Consolidation + Fake Breakout = Sharp Move Down)
fakeBreakoutShortCondition = false
var float fakeBreakoutShortEntry = 0.0  
var float fakeBreakoutShortStop = 0.0
var float fakeBreakoutShortTarget = 0.0

if orhDetermined and consolidationPhase and fakeBreakoutAboveORH
    // Sharp move down after fake breakout
    if close < orh and close < low[1]
        fakeBreakoutShortCondition := true
        fakeBreakoutShortEntry := low
        fakeBreakoutShortStop := orh
        // Use optimal target: ORH/ORL range or nearest pivot
        fakeBreakoutShortTarget := getOptimalTarget(fakeBreakoutShortEntry, false, fakeBreakoutShortStop)

// ============================================================================
// PIVOT ZONE TRACKING & MANDATORY EXITS
// ============================================================================

// Update zone tracking every bar
if isTradingSession()
    // Update zone tracking (direct execution instead of function)
    previousZone := currentZone
    currentZone := getCurrentZone()
    zoneChanged := currentZone != previousZone
    
    // Update aggressive zone flags
    isAggressiveBullishZone := currentZone == "bullish" and close >= r1 and close <= r2
    isAggressiveBearishZone := currentZone == "bearish" and close <= s1 and close >= s2
    
    // Check for mandatory exits at critical levels
    [exitTriggered, reason] = checkMandatoryExits()
    if exitTriggered and not mandatoryExitTriggered
        mandatoryExitTriggered := true
        exitReason := reason
        
        // Generate alert for mandatory exit
        alert("🚨 MANDATORY EXIT: " + reason + " - Close all positions immediately!")

// ============================================================================
// TRENDING DAY DETECTION
// ============================================================================

// Trending Day Detection Logic based on Setup Instructions
if isTradingSession() and shouldShowSignals()
    
    // BULLISH TRENDING DAY CONDITIONS:
    // 1. Bear Trap + ORH Breakout (Bear Trap + ORB Long)
    // 2. Failed Bear Trap + ORH Breakout (Failed Bear Trap + ORB Long)
    if not trendingDayBullish and bullishSetupCount >= 2
        if (hasBearTrap and hasORHBreakout) or (hasFailedBearTrap and hasORHBreakout)
            trendingDayBullish := true
            if hasBearTrap and hasORHBreakout
                trendingDayPattern := "BEAR TRAP + ORH BO"
            else if hasFailedBearTrap and hasORHBreakout
                trendingDayPattern := "FAILED BEAR TRAP + ORH BO"
    
    // BEARISH TRENDING DAY CONDITIONS:
    // 1. Bull Trap + ORL Breakdown (Bull Trap + ORB Short)
    // 2. Failed Bull Trap + ORL Breakdown (Failed Bull Trap + ORB Short)
    if not trendingDayBearish and bearishSetupCount >= 2
        if (hasBullTrap and hasORLBreakdown) or (hasFailedBullTrap and hasORLBreakdown)
            trendingDayBearish := true
            if hasBullTrap and hasORLBreakdown
                trendingDayPattern := "BULL TRAP + ORL BD"
            else if hasFailedBullTrap and hasORLBreakdown
                trendingDayPattern := "FAILED BULL TRAP + ORL BD"

