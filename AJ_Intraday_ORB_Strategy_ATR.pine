    line.new(bar_index, labelY, bar_index, low + connectionGap, color=color.orange, width=1, style=line.style_dashed)
    bearTrapWhipsawTriggered := true

// Additional Whipsaw for Bull Trap - Show enhanced label
if showTrapSignals and shouldShowSignals() and bullTrapAdditionalWhipsaw and not bullTrapWhipsawTriggered
    bullTrapWhipsawTime := getCurrentTimeString()
    // Enhanced whipsaw label
    labelText = "WHIPSAW"
    labelY = getLabelY(high, true, "WHIPSAW")
    bullTrapWhipsawLabel := label.new(bar_index, labelY, labelText, color=color.orange, style=label.style_label_down, textcolor=color.white, size=size.small, tooltip="Additional Whipsaw for Bull Trap - Momentum will come after whipsaw. Higher probability signal with more trapped participants.")
    line.new(bar_index, labelY, bar_index, high - connectionGap, color=color.orange, width=1, style=line.style_dashed)
    bullTrapWhipsawTriggered := true

// Additional Whipsaw for ORB Long - Show enhanced label
if showEntrySignals and shouldShowSignals() and orbLongAdditionalWhipsaw and not orbLongWhipsawTriggered
    orbLongWhipsawTime := getCurrentTimeString()
    // Enhanced whipsaw label
    labelText = "WHIPSAW"
