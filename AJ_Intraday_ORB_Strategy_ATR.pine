// Additional Whipsaw for Bear Trap - Show enhanced label
if showTrapSignals and shouldShowSignals() and bearTrapAdditionalWhipsaw and not bearTrapWhipsawTriggered
    bearTrapWhipsawTime := getCurrentTimeString()
    // Enhanced whipsaw label
