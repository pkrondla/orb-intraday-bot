showOnlyActive = input.bool(false, "Show Only Active Trades", tooltip="Display only active trades in table", group="Trade Table")
tablePosition = input.string("top_right", "Table Position", options=["top_center", "top_right", "top_left", "middle_center", "middle_right", "middle_left", "bottom_center", "bottom_right", "bottom_left"], tooltip="Position of trade table on chart", group="Trade Table")

