// BEAR TRAP CASE 2 - Confirmation Failed (No reverse retest expected, higher momentum)
if showTrapSignals and shouldShowSignals() and bearTrapCase2 and not bearTrapCase2Triggered and isValidZoneForSignal("BEAR_TRAP_C2")
    bearTrapCase2EntryTime := getCurrentTimeString()
    // Enhanced label with case-specific information
    labelText = "BEAR TRAP C2"
