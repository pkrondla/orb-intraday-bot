    bullTrapCase2Label := label.new(bar_index, labelY, labelText, color=color.maroon, style=label.style_label_down, textcolor=color.white, size=size.small, tooltip=tooltipText)
    line.new(bar_index, labelY, bar_index, high - connectionGap, color=color.maroon, width=1, style=line.style_dashed)
    addTradeToTable("BULL TRAP C2", bullTrapCase2EntryTime, bullTrapCase2Entry, bullTrapCase2Stop, bullTrapCase2Target, 50, 2500.0, "Active", 0.0, bar_index)
    bullTrapCase2Triggered := true

// BEAR TRAP CASE 1 - No Confirmation (Higher retest probability, less trapped participants)
if showTrapSignals and shouldShowSignals() and bearTrapCase1 and not bearTrapCase1Triggered and isValidZoneForSignal("BEAR_TRAP_C1")
    bearTrapCase1EntryTime := getCurrentTimeString()
