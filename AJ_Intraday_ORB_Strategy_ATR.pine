// Manual Alert Control (Pine Script doesn't support clicking)
manualDismissMode = input.string("Auto-Expire Only", "Alert Dismissal Mode", options=["Auto-Expire Only", "Quick Dismiss (5 bars)", "Extended Time (20 bars)", "Manual Reset"], tooltip="Control how alerts are dismissed since Pine Script doesn't support clicking", group="Alert Control")
clearAllAlerts = input.bool(false, "🗑️ Clear All Alerts Now", tooltip="Toggle this ON to immediately clear all current alerts, then toggle back OFF", group="Alert Control")
priorityOnlyMode = input.bool(false, "⭐ High Priority Only", tooltip="Show only high priority alerts (Target hits, Major entries)", group="Alert Control")

// Historical Data Settings
historicalDataMode = input.string("All Days", "Historical Data Display", options=["All Days", "Last Day Only", "Recent Days"], tooltip="Control which days' signals are shown: All Days (complete history), Last Day Only (current trading day), Recent Days (last few days)", group="Historical Data")
recentDaysCount = input.int(3, "Recent Days Count", minval=1, maxval=10, tooltip="Number of recent trading days to show when 'Recent Days' mode is selected", group="Historical Data")

// ============================================================================
// ON-SCREEN ALERT SYSTEM ARRAYS - PHASE 1 (Declared early)
// ============================================================================

// Alert data structure for prominent on-screen notifications
var array<string> alertMessages = array.new<string>()
var array<string> alertTypes = array.new<string>()
var array<int> alertBarIndexes = array.new<int>()
var array<color> alertColors = array.new<color>()
var array<int> alertPriorities = array.new<int>()    // 1=Low, 2=Medium, 3=High, 4=Critical
var array<string> alertIcons = array.new<string>()
var array<bool> alertDismissed = array.new<bool>()   // Track manually dismissed alerts
var array<int> alertIDs = array.new<int>()           // Unique IDs for each alert
var alertCounter = 0

// ============================================================================
// ON-SCREEN ALERT HELPER FUNCTIONS - PHASE 1
// ============================================================================

// Convert alert size string to Pine Script size
getAlertTextSize() =>
    switch alertSize
        "tiny" => size.tiny
        "small" => size.small
        "normal" => size.normal
        "large" => size.large
        "huge" => size.huge
        => size.large

// Convert alert position to table position
getAlertTablePosition() =>
    switch alertPosition
        "top_left" => position.top_left
        "top_center" => position.top_center
        "top_right" => position.top_right
        "middle_left" => position.middle_left
        "middle_center" => position.middle_center
        "middle_right" => position.middle_right
        "bottom_left" => position.bottom_left
        "bottom_center" => position.bottom_center
        "bottom_right" => position.bottom_right
        => position.top_left

// Get alert icon based on type and priority
getAlertIcon(alertType, priority) =>
    if alertType == "ENTRY"
        priority >= 3 ? "🚀" : "📈"
    else if alertType == "EXIT"
        priority >= 3 ? "🎯" : "💰"
    else if alertType == "BLOCKED"
        "❌"
    else if alertType == "ZONE"
        "📍"
    else if alertType == "PATTERN"
        "⚡"
    else if alertType == "MANDATORY"
        "🚨"
    else if alertType == "BREAKOUT"
        "💥"
    else
        "🔔"

// Get alert color based on signal type
getAlertColor(signalType, alertType) =>
    if alertType == "ENTRY"
        if str.contains(signalType, "LONG") or str.contains(signalType, "BEAR TRAP")
            color.green
        else
            color.red
    else if alertType == "EXIT"
        if str.contains(signalType, "Target")
            color.green
        else if str.contains(signalType, "SL")
            color.red
        else
            color.orange  // EOD
    else if alertType == "BLOCKED"
        color.orange
    else
        color.blue

// Helper functions that don't modify global variables
getAlertColorForType(signalType, alertType) =>
    if alertType == "ENTRY"
        if str.contains(signalType, "LONG") or str.contains(signalType, "BEAR TRAP")
            color.green
        else
            color.red
    else if alertType == "EXIT"
        if str.contains(signalType, "Target")
            color.green
        else if str.contains(signalType, "SL")
            color.red
        else
            color.orange  // EOD
    else if alertType == "BLOCKED"
        color.orange
    else
        color.blue

// Function to add alert (returns true if should be added)
shouldAddAlert(alertType) =>
    enableOnScreenAlerts and ((alertType == "ENTRY" and showEntryAlerts) or (alertType == "EXIT" and showExitAlerts) or (alertType == "BLOCKED" and showBlockedAlerts))

// ============================================================================
// TRADE DATA ARRAYS (Declared early to avoid undeclared identifier errors)
// ============================================================================

// Trade data structure - using arrays to store trade information
var array<string> tradeSignals = array.new<string>()
var array<string> tradeTimes = array.new<string>()
var array<string> tradeExitTimes = array.new<string>()
var array<float> tradeEntries = array.new<float>()
var array<float> tradeStops = array.new<float>()
var array<float> tradeTargets = array.new<float>()
var array<int> tradeQuantities = array.new<int>()     // New: Position quantities
var array<float> tradeRiskAmounts = array.new<float>() // New: Risk amounts in ₹
var array<string> tradeStatuses = array.new<string>()
var array<float> tradePnLs = array.new<float>()
var array<int> tradeBars = array.new<int>()

// Position tracking variables
var int currentPositions = 0
var float currentExposure = 0.0

// Trade table variable
var table tradeTable = na

// ============================================================================
// ATR & VOLATILITY FUNCTIONS
// ============================================================================

// Enhanced ATR calculation for 3-minute timeframe with cold start protection
getReliableATR() =>
    atr14 = ta.atr(atrLength)       // Full period ATR
    atr7 = ta.atr(math.max(atrLength/2, 3))  // Half period ATR
    atr3 = ta.atr(3)                // Short period ATR
    currentRange = high - low        // Current candle range
    openRange = math.abs(close - open)  // Current candle body
    
    // Progressive fallback system for early market hours
    if not na(atr14)
        atr14                        // Use full ATR when available
    else if not na(atr7)
        atr7 * 1.3                  // Scale up half-period ATR
    else if not na(atr3)
        atr3 * 1.8                  // Scale up short-period ATR
    else
        math.max(currentRange, openRange) * 1.5  // Emergency fallback

// Classify volatility based on 3-minute ATR values
classifyVolatility(atrValue) =>
    if atrValue <= 12
        ["VERY LOW", color.new(color.blue, 0)]
    else if atrValue <= 20
        ["LOW", color.new(color.green, 0)]
    else if atrValue <= 35
        ["NORMAL", color.new(color.yellow, 0)]
    else if atrValue <= 55
        ["HIGH", color.new(color.orange, 0)]
    else if atrValue <= 75
        ["VERY HIGH", color.new(color.red, 0)]
    else
        ["EXTREME", color.new(color.purple, 0)]

// Get volatility-adjusted ATR multiplier
getVolatilityMultiplier(atrValue) =>
    [volatilityLevel, levelColor] = classifyVolatility(atrValue)
    
    switch volatilityLevel
        "VERY LOW" => 1.0      // Tight stops in very calm markets
        "LOW" => 1.1           // Slightly wider for low volatility
        "NORMAL" => 1.2        // Standard adjustment for normal volatility
        "HIGH" => 1.4          // Wider for active markets
        "VERY HIGH" => 1.7     // Much wider for volatile markets
        "EXTREME" => 2.1       // Extra wide for chaotic markets
        => 1.2                 // Default

// Get pattern-specific ATR multiplier
getPatternATRMultiplier(signalType) =>
    switch signalType
        "ORB_LONG" => orbATRMultiplier
        "ORB_SHORT" => orbATRMultiplier
        "BULL_TRAP" => trapCase2Multiplier          // Standard Bull Trap
        "BEAR_TRAP" => trapCase2Multiplier          // Standard Bear Trap
        "BULL_TRAP_C1" => trapCase1Multiplier       // Conservative case
        "BULL_TRAP_C2" => trapCase2Multiplier       // Aggressive case
        "BEAR_TRAP_C1" => trapCase1Multiplier       // Conservative case
        "BEAR_TRAP_C2" => trapCase2Multiplier       // Aggressive case
        "CONS_LONG" => consolidationATRMultiplier   // Consolidation breakout
        "CONS_SHORT" => consolidationATRMultiplier  // Consolidation breakdown
        "WHIPSAW" => whipsawATRMultiplier           // Whipsaw reversal
        "FAKE_BREAKOUT" => fakeBreakoutATRMultiplier // Fake breakout/breakdown
        "BOTH_SIDES_TRAP" => trapCase2Multiplier * 1.5  // Extra wide for explosive moves
        => baseATRMultiplier   // Default multiplier

// Calculate dynamic stop loss based on ATR and pattern
calculateDynamicStop(entryPrice, signalType, isLong, float orbLevel = na) =>
    atrValue = getReliableATR()
    patternMultiplier = getPatternATRMultiplier(signalType)
    volatilityMultiplier = getVolatilityMultiplier(atrValue)
    
    // Calculate ATR-based stop distance
    finalMultiplier = patternMultiplier * volatilityMultiplier
    atrStopDistance = atrValue * finalMultiplier
    
    // Calculate stop levels
    atrStopLevel = isLong ? entryPrice - atrStopDistance : entryPrice + atrStopDistance
    
    // If ORB level is available, compare with ATR stop
    finalStopLevel = if not na(orbLevel)
        // Take the more conservative stop (closer to entry for better risk management)
        isLong ? math.max(orbLevel, atrStopLevel) : math.min(orbLevel, atrStopLevel)
    else
        // Use pure ATR stop when no ORB level available
        atrStopLevel
    
    [finalStopLevel, atrStopDistance, atrValue, finalMultiplier]

// Note: Removed getInstrumentType function - no longer needed without lot sizing

// Calculate optimal position size based on capital, risk, and ATR
calculatePositionSize(entryPrice, stopPrice, signalType) =>
    // Calculate risk per unit
    pointsAtRisk = math.abs(entryPrice - stopPrice)
    
    // Calculate risk amount in rupees
    riskAmount = tradingCapital * (riskPerTrade / 100)
    
    // Get pattern-specific risk adjustment
    patternRiskMultiplier = switch signalType
        "CONS_LONG" => 0.8          // Lower risk for high probability
        "CONS_SHORT" => 0.8         // Lower risk for high probability
        "WHIPSAW" => 0.6            // Lowest risk for highest probability
        "FAKE_BREAKOUT" => 0.7      // Lower risk for quick reversals
        "BULL_TRAP_C1" => 0.9       // Slightly lower risk for conservative case
        "BEAR_TRAP_C1" => 0.9       // Slightly lower risk for conservative case
        "BULL_TRAP_C2" => 1.1       // Slightly higher risk for aggressive case
        "BEAR_TRAP_C2" => 1.1       // Slightly higher risk for aggressive case
        => 1.0                      // Standard risk for other patterns
    
    // Adjust risk amount based on pattern
    adjustedRiskAmount = riskAmount * patternRiskMultiplier
    
    // Calculate optimal quantity - simplified approach
    [finalQuantity, actualRiskAmount] = if pointsAtRisk > 0
        optimalQuantity = adjustedRiskAmount / pointsAtRisk
        
        // Round UP to next whole number (ceiling), minimum 1 unit
        calculatedQuantity = math.max(math.ceil(optimalQuantity), 1)
        
        // Calculate actual risk amount
        calculatedRiskAmount = pointsAtRisk * calculatedQuantity
        [calculatedQuantity, calculatedRiskAmount]
    else
        // Fallback if stop calculation fails
        [1, riskAmount]
    
    [finalQuantity, actualRiskAmount]

// Check if new position is allowed based on limits
isPositionAllowed(newRiskAmount) =>
    // Check position count limit
    positionCountOK = currentPositions < maxPositions
    
    // Check total exposure limit (max 80% of capital)
    maxExposure = tradingCapital * 0.8
    exposureOK = (currentExposure + newRiskAmount) <= maxExposure
    
    positionCountOK and exposureOK

// Position tracking helper - returns updated values instead of modifying globals
getUpdatedPositionTracking(riskAmount, isEntry) =>
    newPositions = if isEntry
        currentPositions + 1
    else
        math.max(currentPositions - 1, 0)
        
    newExposure = if isEntry
        currentExposure + riskAmount
    else
        math.max(currentExposure - riskAmount, 0.0)
        
    [newPositions, newExposure]

// ============================================================================
// TIME FUNCTIONS
// ============================================================================

isMarketOpen() =>
    not na(time(timeframe.period, "0930-1530", "Asia/Kolkata"))

isORBPeriod() =>
    not na(time(timeframe.period, "0915-0930", "Asia/Kolkata"))

isTradingSession() =>
    not na(time(timeframe.period, "0915-1530", "Asia/Kolkata"))

// Determine if signals should be shown based on user settings
shouldShowSignals() =>
    switch historicalDataMode
        "All Days" => true  // Show for all historical days
        "Last Day Only" => 
            // Show only for current/last trading day
            // Use day change detection for better accuracy
            var bool isCurrentDay = false
            if ta.change(dayofweek) != 0 or barstate.isfirst
                isCurrentDay := true
            else if barstate.islast
                isCurrentDay := true
            isCurrentDay or barstate.isrealtime
        "Recent Days" =>
            // Show for recent trading days based on user selection
            // Calculate approximate bars per day (assuming 6.25 hours * 20 bars per hour = 125 bars per day)
            barsPerDay = 125  // Approximate for 3-minute chart (375 minutes / 3 = 125 bars)
            recentBarsThreshold = recentDaysCount * barsPerDay
            bar_index >= last_bar_index - recentBarsThreshold or barstate.isrealtime
        => true  // Default: show all

// ============================================================================
// DAILY PIVOT CALCULATION
// ============================================================================

// Get previous day's OHLC data
[prevHigh, prevLow, prevClose] = request.security(syminfo.tickerid, "1D", [high[1], low[1], close[1]])

// Calculate pivot points manually
pivot = (prevHigh + prevLow + prevClose) / 3
r1 = 2 * pivot - prevLow
s1 = 2 * pivot - prevHigh
r2 = pivot + (prevHigh - prevLow)
s2 = pivot - (prevHigh - prevLow)
r3 = prevHigh + 2 * (pivot - prevLow)
s3 = prevLow - 2 * (prevHigh - pivot)

// ============================================================================
// MARKET ZONE FUNCTIONS
// ============================================================================

isNeutralZone() =>
    close >= s1 and close <= r1

isBullishZone() =>
    close > r1

isBearishZone() =>
    close < s1

