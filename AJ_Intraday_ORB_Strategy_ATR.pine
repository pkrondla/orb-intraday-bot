    orbShortWhipsawLabel := label.new(bar_index, labelY, labelText, color=color.orange, style=label.style_label_down, textcolor=color.white, size=size.small, tooltip="Additional Whipsaw for ORB Short - ORL holding as resistance. SL will not hit. Higher probability signal.")
    line.new(bar_index, labelY, bar_index, high - connectionGap, color=color.orange, width=1, style=line.style_dashed)
    orbShortWhipsawTriggered := true

// Consolidation Breakout Signals - Only show when conditions are met (once per day) (with zone filtering)
if shouldShowSignals() and consolidationBreakoutLong and not consBreakoutLongTriggered and isValidZoneForSignal("CONS_LONG")
    consBreakoutLongEntryTime := getCurrentTimeString()
    // Minimal chart label
    labelText = "CONS LONG"
    labelY = getLabelY(low, false, "CONS_BREAKOUT")
    tooltipText = "CONSOLIDATION BREAKOUT LONG\nEntry Time: " + consBreakoutLongEntryTime + "\nEntry: " + str.tostring(consBreakoutLongEntry, "#.##") + "\nStop Loss: " + str.tostring(consBreakoutLongStop, "#.##") + "\nTarget: " + str.tostring(consBreakoutLongTarget, "#.##") + "\nStrategy: Multiple rejections at ORH for 45+ minutes, direct breakout entry without retest."
    consBreakoutLongLabel := label.new(bar_index, labelY, labelText, color=color.green, style=label.style_label_up, textcolor=color.white, size=size.small, tooltip=tooltipText)
    line.new(bar_index, labelY, bar_index, low + connectionGap, color=color.green, width=1, style=line.style_dashed)
    // Add to trade table
    addTradeToTable("CONS LONG", consBreakoutLongEntryTime, consBreakoutLongEntry, consBreakoutLongStop, consBreakoutLongTarget, 50, 2500.0, "Active", 0.0, bar_index)
    consBreakoutLongTriggered := true

if shouldShowSignals() and consolidationBreakoutShort and not consBreakoutShortTriggered and isValidZoneForSignal("CONS_SHORT")
    consBreakoutShortEntryTime := getCurrentTimeString()
    // Minimal chart label
    labelText = "CONS SHORT"
    labelY = getLabelY(high, true, "CONS_BREAKOUT")
    tooltipText = "CONSOLIDATION BREAKOUT SHORT\nEntry Time: " + consBreakoutShortEntryTime + "\nEntry: " + str.tostring(consBreakoutShortEntry, "#.##") + "\nStop Loss: " + str.tostring(consBreakoutShortStop, "#.##") + "\nTarget: " + str.tostring(consBreakoutShortTarget, "#.##") + "\nStrategy: Multiple rejections at ORL for 45+ minutes, direct breakdown entry without retest."
    consBreakoutShortLabel := label.new(bar_index, labelY, labelText, color=color.red, style=label.style_label_down, textcolor=color.white, size=size.small, tooltip=tooltipText)
    line.new(bar_index, labelY, bar_index, high - connectionGap, color=color.red, width=1, style=line.style_dashed)
    // Add to trade table
    addTradeToTable("CONS SHORT", consBreakoutShortEntryTime, consBreakoutShortEntry, consBreakoutShortStop, consBreakoutShortTarget, 50, 2500.0, "Active", 0.0, bar_index)
    consBreakoutShortTriggered := true

// ============================================================================
