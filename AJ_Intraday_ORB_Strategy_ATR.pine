            array.push(alertMessages, alertMsg)
            array.push(alertTypes, "ENTRY")
            array.push(alertBarIndexes, bar_index)
            array.push(alertColors, color.red)
            array.push(alertPriorities, 3)
            array.push(alertIcons, "🚀")
            array.push(alertDismissed, false)
            array.push(alertIDs, alertCounter)
            alertCounter += 1
    else
        // Position blocked - create warning label
        warningText = "ORB SHORT\n❌ BLOCKED"
        warningTooltip = "Position blocked:\n• Max positions: " + str.tostring(maxPositions) + "\n• Current: " + str.tostring(currentPositions) + "\n• Exposure: ₹" + str.tostring(currentExposure, "#")
        label.new(bar_index, labelY, warningText, color=color.orange, style=label.style_label_down, textcolor=color.white, size=size.small, tooltip=warningTooltip)
        
        // ❌ ON-SCREEN ALERT for blocked position
        if showBlockedAlerts and enableOnScreenAlerts
            alertMsg = "ORB SHORT BLOCKED\nMax positions: " + str.tostring(maxPositions) + "\nCurrent: " + str.tostring(currentPositions) + "\nExposure: ₹" + str.tostring(currentExposure, "#")
            array.push(alertMessages, alertMsg)
            array.push(alertTypes, "BLOCKED")
            array.push(alertBarIndexes, bar_index)
            array.push(alertColors, color.orange)
            array.push(alertPriorities, 2)
            array.push(alertIcons, "❌")
            array.push(alertDismissed, false)
            array.push(alertIDs, alertCounter)
            alertCounter += 1
    orbShortTriggered := true

// Trap Signals - Only show when conditions are met (once per day) (with zone filtering)
if showTrapSignals and shouldShowSignals() and bullTrapCondition and not bullTrapTriggered and isValidZoneForSignal("BULL_TRAP")
    bullTrapEntryTime := getCurrentTimeString()
    // Minimal chart label
    labelText = "BULL TRAP"
    labelY = getLabelY(high, true, "TRAP")
    tooltipText = "BULL TRAP SIGNAL\nEntry Time: " + bullTrapEntryTime + "\nEntry: " + str.tostring(bullTrapEntry, "#.##") + "\nStop Loss: " + str.tostring(bullTrapStop, "#.##") + "\nTarget: " + str.tostring(bullTrapTarget, "#.##") + "\nStrategy: After ORH breakout, candle closed below ORH. Confirmation at swing low break."
    bullTrapLabel := label.new(bar_index, labelY, labelText, color=color.red, style=label.style_label_down, textcolor=color.white, size=size.small, tooltip=tooltipText)
    line.new(bar_index, labelY, bar_index, high - connectionGap, color=color.red, width=1, style=line.style_dashed)
    // Add to trade table
