//@version=6
indicator("AJ Intraday ORB Strategy", overlay=true, max_labels_count=500)

// ============================================================================
// TIMEFRAME VERIFICATION
// ============================================================================

// Verify script is running on 3-minute timeframe
if timeframe.period != "3"
    runtime.error("⚠️ This strategy is designed for 3-minute timeframe only. Please switch to 3-minute chart.")

// ============================================================================
// INPUT PARAMETERS
// ============================================================================

// ============================================================================
// ATR & POSITION SIZING SETTINGS
// ============================================================================

// Capital & Risk Management
tradingCapital = input.float(500000, "Trading Capital (₹)", minval=10000, maxval=10000000, step=10000, tooltip="Total capital available for trading", group="Position Sizing")

riskPerTrade = input.float(1.0, "Risk Per Trade (%)", minval=0.1, maxval=5.0, step=0.1, tooltip="Maximum risk per trade as percentage of capital", group="Position Sizing")

maxPositions = input.int(5, "Max Simultaneous Positions", minval=1, maxval=10, tooltip="Maximum number of positions to hold simultaneously", group="Position Sizing")

// Note: Removed lot size settings - using direct optimal quantity calculation

// ATR Settings for Dynamic Stops
atrLength = input.int(14, "ATR Length", minval=5, maxval=50, tooltip="Period for ATR calculation (3-minute periods)", group="ATR Settings")

baseATRMultiplier = input.float(1.5, "Base ATR Multiplier", minval=1.0, maxval=5.0, step=0.1, tooltip="Base multiplier for ATR stop loss", group="ATR Settings")

// Pattern-Specific ATR Multipliers
orbATRMultiplier = input.float(1.5, "ORB ATR Multiplier", minval=1.0, maxval=3.0, step=0.1, tooltip="ATR multiplier for ORB signals", group="Pattern ATR")

trapCase1Multiplier = input.float(1.2, "Trap Case 1 Multiplier", minval=0.8, maxval=2.0, step=0.1, tooltip="ATR multiplier for Trap Case 1 (conservative)", group="Pattern ATR")

trapCase2Multiplier = input.float(2.0, "Trap Case 2 Multiplier", minval=1.5, maxval=3.0, step=0.1, tooltip="ATR multiplier for Trap Case 2 (aggressive)", group="Pattern ATR")

consolidationATRMultiplier = input.float(1.0, "Consolidation ATR Multiplier", minval=0.5, maxval=2.0, step=0.1, tooltip="ATR multiplier for consolidation breakouts (high probability)", group="Pattern ATR")

whipsawATRMultiplier = input.float(1.8, "Whipsaw ATR Multiplier", minval=1.0, maxval=3.0, step=0.1, tooltip="ATR multiplier for whipsaw reversal signals", group="Pattern ATR")

fakeBreakoutATRMultiplier = input.float(0.8, "Fake Breakout ATR Multiplier", minval=0.5, maxval=1.5, step=0.1, tooltip="ATR multiplier for fake breakout signals (quick reversals)", group="Pattern ATR")

// Legacy Fixed Stop Loss (for fallback)
niftyStopLoss = input.float(35, "Fallback Stop Loss (points)", minval=10, maxval=100, tooltip="Fixed stop loss used when ATR is not available", group="ATR Settings")

// Visual Settings
showORLevels = input.bool(true, "Show ORH/ORL Levels", group="Visual")
showEntrySignals = input.bool(true, "Show Entry Signals", group="Visual")
showTrapSignals = input.bool(true, "Show Bull/Bear Trap Signals", group="Visual")
showWhipsawSignals = input.bool(true, "Show Whipsaw Entry Signals", group="Visual")
showNeutralZone = input.bool(true, "Show Market Zone Labels", group="Visual")
showExitMarkers = input.bool(true, "Show Exit Markers on Chart", tooltip="Display visual markers (✓/✗) where trades exit", group="Visual")

orhColor = input.color(color.red, "ORH Color", group="Visual")
orlColor = input.color(color.green, "ORL Color", group="Visual")

// Enhanced Label Positioning Settings
labelDistance = input.float(15.0, "Label Distance from Candles (Points)", minval=5.0, maxval=50.0, step=2.5, tooltip="Fixed distance in points from candle price", group="Label Settings")
labelSpacing = input.float(25.0, "Label Spacing (Points)", minval=10.0, maxval=100.0, step=5.0, tooltip="Minimum spacing between overlapping labels", group="Label Settings")
connectionGap = input.float(2.0, "Connection Line Gap (Points)", minval=0.0, maxval=10.0, step=0.5, tooltip="Gap between connection line and candle high/low", group="Label Settings")
maxLabelProximity = input.int(8, "Label Proximity Range (Bars)", minval=5, maxval=15, tooltip="Consider labels within this many bars for overlap prevention", group="Label Settings")
smartDistribution = input.bool(true, "Smart Label Distribution", tooltip="Automatically distribute labels to less crowded areas when many overlap", group="Label Settings")
zoneLabelDistance = input.int(10, "Zone Label Distance (Bars)", minval=1, maxval=50, step=1, tooltip="Distance in bars from current price to display the zone label on x-axis", group="Label Settings")

// Zone-based positioning system
zoneSpacing = input.float(20.0, "Zone Spacing (Points)", minval=10.0, maxval=50.0, step=5.0, tooltip="Vertical spacing between different signal zones", group="Label Settings")
enableZoneAllocation = input.bool(false, "Enable Zone Allocation", tooltip="Organize labels by signal type into distinct vertical zones. Disable for labels closer to candles", group="Label Settings")

// Trade Table Settings
showTradeTable = input.bool(true, "Show Trade Table", tooltip="Display comprehensive trade table above chart", group="Trade Table")
