        array.push(alertDismissed, false)
        array.push(alertIDs, alertCounter)
        alertCounter += 1
    
    bearTrapTriggered := true

// ORB Follow-up Failure Signals - Case 1 & Case 2

// BULL TRAP CASE 1 - No Confirmation (Higher retest probability, less trapped participants)
if showTrapSignals and shouldShowSignals() and bullTrapCase1 and not bullTrapCase1Triggered and isValidZoneForSignal("BULL_TRAP_C1")
    bullTrapCase1EntryTime := getCurrentTimeString()
    // Enhanced label with case-specific information
