// Dynamic label updates using stored final texts

if isTradingSession()
    // NOTE: Legacy exit label updates disabled - using new array-based exit marker system
    // Entry labels now remain clean without exit status text appended
    // Exit markers are created separately via createExitMarker() function
    
    // All legacy exit label updates removed - now using array-based exit marker system only
    
    // Whipsaw Long exit label update (store final text once)
    if not na(whipsawLongLabel) and whipsawLongTriggered and whipsawLongExitStatus != "" and whipsawLongFinalLabel == ""
        // Store the final label text permanently
        whipsawText = threeLL ? "3LL REVERSAL LONG" : "2LL REVERSAL LONG"
        whipsawLongFinalLabel := whipsawText + "\n" + whipsawLongExitStatus
        label.set_text(whipsawLongLabel, whipsawLongFinalLabel)
    else if not na(whipsawLongLabel) and whipsawLongFinalLabel != ""
        // Use stored final text (prevents values from changing)
        label.set_text(whipsawLongLabel, whipsawLongFinalLabel)
    
    // Whipsaw Short exit label update (store final text once)
    if not na(whipsawShortLabel) and whipsawShortTriggered and whipsawShortExitStatus != "" and whipsawShortFinalLabel == ""
        // Store the final label text permanently
        whipsawText = threeHH ? "3HH REVERSAL SHORT" : "2HH REVERSAL SHORT"
        whipsawShortFinalLabel := whipsawText + "\n" + whipsawShortExitStatus
        label.set_text(whipsawShortLabel, whipsawShortFinalLabel)
    else if not na(whipsawShortLabel) and whipsawShortFinalLabel != ""
        // Use stored final text (prevents values from changing)
        label.set_text(whipsawShortLabel, whipsawShortFinalLabel)

// ============================================================================
// VISUAL INDICATORS
// ============================================================================

// Market Zone Labels based on current price (always on top of ORH)
currentZoneType = isNeutralZone() ? "NEUTRAL" : isBullishZone() ? "BULLISH" : "BEARISH"

// Function to get active trades P&L summary
getActiveTradesPnL() =>
    activeTrades = 0
    totalPnL = 0.0
    tradeDetails = ""
    
    // Check ORB LONG
    if orbLongTriggered and orbLongExitStatus == ""
        pnl = close - orbLongEntry
        activeTrades := activeTrades + 1
        totalPnL := totalPnL + pnl
        tradeDetails := tradeDetails + "ORB LONG: " + (pnl > 0 ? "+" : "") + str.tostring(pnl, "#.##") + " pts\n"
    
    // Check ORB SHORT
    if orbShortTriggered and orbShortExitStatus == ""
        pnl = orbShortEntry - close
        activeTrades := activeTrades + 1
        totalPnL := totalPnL + pnl
        tradeDetails := tradeDetails + "ORB SHORT: " + (pnl > 0 ? "+" : "") + str.tostring(pnl, "#.##") + " pts\n"
    
    // Check BULL TRAP
    if bullTrapTriggered and bullTrapExitStatus == ""
        pnl = bullTrapEntry - close
        activeTrades := activeTrades + 1
        totalPnL := totalPnL + pnl
        tradeDetails := tradeDetails + "BULL TRAP: " + (pnl > 0 ? "+" : "") + str.tostring(pnl, "#.##") + " pts\n"
    
    // Check BEAR TRAP
    if bearTrapTriggered and bearTrapExitStatus == ""
        pnl = close - bearTrapEntry
        activeTrades := activeTrades + 1
        totalPnL := totalPnL + pnl
        tradeDetails := tradeDetails + "BEAR TRAP: " + (pnl > 0 ? "+" : "") + str.tostring(pnl, "#.##") + " pts\n"
    
    // Check CONS BREAKOUT LONG
    if consBreakoutLongTriggered and consBreakoutLongExitStatus == ""
        pnl = close - consBreakoutLongEntry
        activeTrades := activeTrades + 1
        totalPnL := totalPnL + pnl
        tradeDetails := tradeDetails + "CONS BO LONG: " + (pnl > 0 ? "+" : "") + str.tostring(pnl, "#.##") + " pts\n"
    
    // Check CONS BREAKOUT SHORT
    if consBreakoutShortTriggered and consBreakoutShortExitStatus == ""
        pnl = consBreakoutShortEntry - close
        activeTrades := activeTrades + 1
        totalPnL := totalPnL + pnl
        tradeDetails := tradeDetails + "CONS BO SHORT: " + (pnl > 0 ? "+" : "") + str.tostring(pnl, "#.##") + " pts\n"
    
    // Check FAKE BREAKOUT LONG
    if fakeBreakoutLongTriggered and fakeBreakoutLongExitStatus == ""
        pnl = close - fakeBreakoutLongEntry
        activeTrades := activeTrades + 1
        totalPnL := totalPnL + pnl
        tradeDetails := tradeDetails + "FAKE BD LONG: " + (pnl > 0 ? "+" : "") + str.tostring(pnl, "#.##") + " pts\n"
    
    // Check FAKE BREAKOUT SHORT
    if fakeBreakoutShortTriggered and fakeBreakoutShortExitStatus == ""
        pnl = fakeBreakoutShortEntry - close
        activeTrades := activeTrades + 1
        totalPnL := totalPnL + pnl
        tradeDetails := tradeDetails + "FAKE BO SHORT: " + (pnl > 0 ? "+" : "") + str.tostring(pnl, "#.##") + " pts\n"
    
    [activeTrades, totalPnL, tradeDetails]



// Display zone label continuously during trading session, positioned at user-defined distance
// Only show for current day and when signals should be displayed
if showNeutralZone and shouldShowSignals() and isTradingSession() and not na(orh)
    // Delete previous zone label if it exists
    if not na(currentZoneLabel)
        label.delete(currentZoneLabel)
        currentZoneLabel := na
    
    // Position zone label using zone allocation system
    zoneY = getZoneBasedY(orh, "ZONE_INFO", true)
    
    // Get current ATR and volatility information
    currentATR = getReliableATR()
    [volatilityLevel, volColor] = classifyVolatility(currentATR)
    
    // Build enhanced zone text with volatility information
    zoneText = ""
    zoneColor = color.yellow
    textColor = color.black
    
    if currentZoneType == "NEUTRAL"
        zoneText := "NEUTRAL ZONE\nVol: " + volatilityLevel + " (" + str.tostring(currentATR, "#.#") + ")"
        zoneColor := color.yellow
        textColor := color.black
    else if currentZoneType == "BULLISH"
        zoneText := "BULLISH ZONE\nVol: " + volatilityLevel + " (" + str.tostring(currentATR, "#.#") + ")"
        zoneColor := color.green
        textColor := color.white
    else if currentZoneType == "BEARISH"
        zoneText := "BEARISH ZONE\nVol: " + volatilityLevel + " (" + str.tostring(currentATR, "#.#") + ")"
        zoneColor := color.red
        textColor := color.white
    
    // Create enhanced tooltip with zone and volatility information
    volatilityMultiplier = getVolatilityMultiplier(currentATR)
    tooltipText = ""
    if currentZoneType == "NEUTRAL"
        tooltipText := "NEUTRAL ZONE\nPrice: " + str.tostring(close, "#.##") + "\nS1: " + str.tostring(s1, "#.##") + " | R1: " + str.tostring(r1, "#.##") + "\n\nVOLATILITY: " + volatilityLevel + "\nATR (3-min): " + str.tostring(currentATR, "#.#") + " points\nMultiplier: " + str.tostring(volatilityMultiplier, "#.#") + "x\n\nTrading Rules:\n• Avoid aggressive trading\n• Scalp with ORB setups only\n• Quick in & out"
    else if currentZoneType == "BULLISH"
        tooltipText := "BULLISH ZONE\nPrice: " + str.tostring(close, "#.##") + "\nAbove R1: " + str.tostring(r1, "#.##") + "\nTarget R2: " + str.tostring(r2, "#.##") + "\n\nVOLATILITY: " + volatilityLevel + "\nATR (3-min): " + str.tostring(currentATR, "#.#") + " points\nMultiplier: " + str.tostring(volatilityMultiplier, "#.#") + "x\n\nTrading Rules:\n• Only BULLISH trades\n• ORH Breakout ✓\n• Bear Trap ✓\n• NO SHORTS!"
    else if currentZoneType == "BEARISH"
        tooltipText := "BEARISH ZONE\nPrice: " + str.tostring(close, "#.##") + "\nBelow S1: " + str.tostring(s1, "#.##") + "\nTarget S2: " + str.tostring(s2, "#.##") + "\n\nVOLATILITY: " + volatilityLevel + "\nATR (3-min): " + str.tostring(currentATR, "#.#") + " points\nMultiplier: " + str.tostring(volatilityMultiplier, "#.#") + "x\n\nTrading Rules:\n• Only BEARISH trades\n• ORL Breakdown ✓\n• Bull Trap ✓\n• NO LONGS!"
    
    // Calculate horizontal position based on user setting (distance from current bar)
    zoneX = bar_index + zoneLabelDistance
    currentZoneLabel := label.new(zoneX, zoneY, zoneText, color=zoneColor, style=label.style_label_down, textcolor=textColor, size=size.small, tooltip=tooltipText)
else
    // Clean up zone label when not showing signals or outside trading session
    if not na(currentZoneLabel)
        label.delete(currentZoneLabel)
        currentZoneLabel := na

// ORH/ORL Detection and Labeling - Combined approach

// Draw ORH label when finalized and not yet drawn
if showORLevels and shouldShowSignals() and orhDetermined and not orhLabelDrawn and orhBarIndex > 0
    // Draw finalized ORH label
    labelY = drawSignalLabel(orhBarIndex, orh, "ORH (FINAL)\n" + str.tostring(orh, "#.##"), orhColor, true, "Opening Range High: Finalized when price stopped making higher highs using 3-candle pattern (current candle lower high than previous, previous higher than candle before)")
    lastLabelY := labelY
    lastLabelBar := orhBarIndex
    orhLabelDrawn := true

// Draw ORL label when finalized and not yet drawn
if showORLevels and shouldShowSignals() and orlDetermined and not orlLabelDrawn and orlBarIndex > 0
    // Draw finalized ORL label
    labelY = drawSignalLabel(orlBarIndex, orl, "ORL (FINAL)\n" + str.tostring(orl, "#.##"), color.green, false, "Opening Range Low: Finalized when price stopped making lower lows using 3-candle pattern (current candle higher low than previous, previous lower than candle before)")
    lastLabelY := labelY
    lastLabelBar := orlBarIndex
    orlLabelDrawn := true

// Show provisional ORH/ORL on current candle (when not finalized)
if showORLevels and shouldShowSignals() and barstate.islast and isTradingSession()
    if not na(orh) and not orhDetermined
        label.new(bar_index, orh, "ORH (PROVISIONAL)\n" + str.tostring(orh, "#.##"), color=color.new(orhColor, 50), style=label.style_label_down, textcolor=color.white, size=size.small, tooltip="Provisional ORH: Current session high, will be finalized when 3-candle pattern confirms")
    
    if not na(orl) and not orlDetermined  
        label.new(bar_index, orl, "ORL (PROVISIONAL)\n" + str.tostring(orl, "#.##"), color=color.new(color.green, 50), style=label.style_label_up, textcolor=color.white, size=size.small, tooltip="Provisional ORL: Current session low, will be finalized when 3-candle pattern confirms")

// Entry Signals - Only show when conditions are met (once per day)
// ORB LONG signal - Create minimal label and add to table (with zone filtering)
if showEntrySignals and shouldShowSignals() and orbLongCondition and not orbLongTriggered and isValidZoneForSignal("ORB_LONG")
    orbLongEntryTime := getCurrentTimeString()
    // Enhanced chart label with zone context
    zoneEmphasis = getTradeEmphasis()
    labelText = "ORB LONG"
    labelY = getLabelY(low, false, "ORB")
    labelColor = isAggressiveBullishZone ? color.new(color.green, 0) : color.green
    // Calculate position sizing first
    [quantity, riskAmount] = calculatePositionSize(orbLongEntry, orbLongStop, "ORB_LONG")
    
    // Get ATR information for tooltip
    currentATR = getReliableATR()
    [volatilityLevel, volColor] = classifyVolatility(currentATR)
    
    tooltipText = "ORB LONG SIGNAL\nEntry Time: " + orbLongEntryTime + "\nEntry: " + str.tostring(orbLongEntry, "#.##") + "\nStop Loss: " + str.tostring(orbLongStop, "#.##") + "\nTarget: " + str.tostring(orbLongTarget, "#.##") + "\n\nPOSITION SIZING:\nQuantity: " + str.tostring(quantity) + " units\nRisk Amount: ₹" + str.tostring(riskAmount, "#") + "\n\nVOLATILITY:\nATR: " + str.tostring(currentATR, "#.#") + " (" + volatilityLevel + ")\nZone: " + getCurrentZone() + "\nEmphasis: " + zoneEmphasis
    orbLongLabel := label.new(bar_index, labelY, labelText, color=labelColor, style=label.style_label_up, textcolor=color.white, size=size.small, tooltip=tooltipText)
    line.new(bar_index, labelY, bar_index, low + connectionGap, color=color.green, width=1, style=line.style_dashed)
    
    // Check if position is allowed
    if isPositionAllowed(riskAmount)
        // Update position tracking
        [newPositions, newExposure] = getUpdatedPositionTracking(riskAmount, true)
        currentPositions := newPositions
        currentExposure := newExposure
        
        // Add to trade table with position sizing
        addTradeToTable("ORB LONG", orbLongEntryTime, orbLongEntry, orbLongStop, orbLongTarget, quantity, riskAmount, "Active", 0.0, bar_index)
        
        // 🚀 ON-SCREEN ALERT for ORB LONG ENTRY
        if showEntryAlerts and enableOnScreenAlerts
            alertMsg = "ORB LONG ENTRY\nEntry: " + str.tostring(orbLongEntry, "#.##") + "\nSL: " + str.tostring(orbLongStop, "#.##") + " (-" + str.tostring(orbLongEntry - orbLongStop, "#") + " pts)\nTarget: " + str.tostring(orbLongTarget, "#.##") + " (+" + str.tostring(orbLongTarget - orbLongEntry, "#") + " pts)\nQty: " + str.tostring(quantity) + " units\nRisk: ₹" + str.tostring(riskAmount, "#")
            alertColor = getAlertColorForType("ORB LONG", "ENTRY")
            alertIcon = getAlertIcon("ENTRY", 3)
            
            // Add to arrays directly
            array.push(alertMessages, alertMsg)
            array.push(alertTypes, "ENTRY")
            array.push(alertBarIndexes, bar_index)
            array.push(alertColors, alertColor)
            array.push(alertPriorities, 3)
            array.push(alertIcons, alertIcon)
            array.push(alertDismissed, false)
            array.push(alertIDs, alertCounter)
            alertCounter += 1
            
            // Play sound if enabled
            if soundEnabled
                alert(alertIcon + " " + alertMsg)
            
            // Limit array size
            while array.size(alertMessages) > maxSimultaneousAlerts * 2
                array.shift(alertMessages)
                array.shift(alertTypes)
                array.shift(alertBarIndexes)
                array.shift(alertColors)
                array.shift(alertPriorities)
                array.shift(alertIcons)
    else
        // Position blocked - create warning label
        warningText = "ORB LONG\n❌ BLOCKED"
        warningTooltip = "Position blocked:\n• Max positions: " + str.tostring(maxPositions) + "\n• Current: " + str.tostring(currentPositions) + "\n• Exposure: ₹" + str.tostring(currentExposure, "#")
        label.new(bar_index, labelY, warningText, color=color.orange, style=label.style_label_up, textcolor=color.white, size=size.small, tooltip=warningTooltip)
        
        // ❌ ON-SCREEN ALERT for blocked position
        if showBlockedAlerts and enableOnScreenAlerts
            alertMsg = "ORB LONG BLOCKED\nMax positions: " + str.tostring(maxPositions) + "\nCurrent: " + str.tostring(currentPositions) + "\nExposure: ₹" + str.tostring(currentExposure, "#")
            alertColor = getAlertColorForType("ORB LONG", "BLOCKED")
            alertIcon = getAlertIcon("BLOCKED", 2)
            
            // Add to arrays directly
            array.push(alertMessages, alertMsg)
            array.push(alertTypes, "BLOCKED")
            array.push(alertBarIndexes, bar_index)
            array.push(alertColors, alertColor)
            array.push(alertPriorities, 2)
            array.push(alertIcons, alertIcon)
            array.push(alertDismissed, false)
            array.push(alertIDs, alertCounter)
            alertCounter += 1
    orbLongTriggered := true

// ORB SHORT signal - Create minimal label and add to table (with zone filtering)
if showEntrySignals and shouldShowSignals() and orbShortCondition and not orbShortTriggered and isValidZoneForSignal("ORB_SHORT")
