    bullTrapCase1Triggered := true

// BULL TRAP CASE 2 - Confirmation Failed (No reverse retest expected, higher momentum)
if showTrapSignals and shouldShowSignals() and bullTrapCase2 and not bullTrapCase2Triggered and isValidZoneForSignal("BULL_TRAP_C2")
    bullTrapCase2EntryTime := getCurrentTimeString()
    // Enhanced label with case-specific information
