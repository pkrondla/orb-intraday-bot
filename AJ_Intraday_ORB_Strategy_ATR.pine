// Declare shared variables for enhanced whipsaw signals
var string enhancedEntryTime = na

// Enhanced Consolidation + Fake Breakout Short
if showWhipsawSignals and shouldShowSignals() and enhancedFakeBreakout and perfectEntryShort and not perfectEntryTriggered and isValidZoneForSignal("CONS_FAKE_BO")
    enhancedEntryTime := getCurrentTimeString()
    fakeBoLabelText = "CONS FAKE BO"
    fakeBoLabelY = getLabelY(high, true, "ENHANCED_WHIPSAW")
    fakeBoTooltipText = "CONSOLIDATION FAKE BREAKOUT\nEntry Time: " + enhancedEntryTime + "\nEntry: " + str.tostring(perfectEntryLevel, "#.##") + "\nResistance: " + str.tostring(consolidationResistance, "#.##") + "\nSupport: " + str.tostring(consolidationSupport, "#.##") + "\nPattern: Consolidation (" + str.tostring(consolidationTouches) + " touches) + Fake breakout above resistance + Sharp reversal down"
    enhancedFakeBreakoutLabel := label.new(bar_index, fakeBoLabelY, fakeBoLabelText, color=color.red, style=label.style_label_down, textcolor=color.white, size=size.small, tooltip=fakeBoTooltipText)
    line.new(bar_index, fakeBoLabelY, bar_index, high - connectionGap, color=color.red, width=1, style=line.style_dashed)
    
    // Add to trade table
    addTradeToTable("CONS FAKE BO", enhancedEntryTime, perfectEntryLevel, consolidationResistance + (niftyStopLoss * syminfo.mintick), consolidationSupport, 50, 2500.0, "Active", 0.0, bar_index)
    perfectEntryTriggered := true

// Enhanced Consolidation + Fake Breakdown Long  
if showWhipsawSignals and shouldShowSignals() and enhancedFakeBreakdown and perfectEntryLong and not perfectEntryTriggered and isValidZoneForSignal("CONS_FAKE_BD")
    enhancedEntryTime := getCurrentTimeString()
    fakeBdLabelText = "CONS FAKE BD"
    fakeBdLabelY = getLabelY(low, false, "ENHANCED_WHIPSAW")
    fakeBdTooltipText = "CONSOLIDATION FAKE BREAKDOWN\nEntry Time: " + enhancedEntryTime + "\nEntry: " + str.tostring(perfectEntryLevel, "#.##") + "\nResistance: " + str.tostring(consolidationResistance, "#.##") + "\nSupport: " + str.tostring(consolidationSupport, "#.##") + "\nPattern: Consolidation (" + str.tostring(consolidationTouches) + " touches) + Fake breakdown below support + Sharp reversal up"
    enhancedFakeBreakdownLabel := label.new(bar_index, fakeBdLabelY, fakeBdLabelText, color=color.green, style=label.style_label_up, textcolor=color.white, size=size.small, tooltip=fakeBdTooltipText)
    line.new(bar_index, fakeBdLabelY, bar_index, low + connectionGap, color=color.green, width=1, style=line.style_dashed)
    
    // Add to trade table  
    addTradeToTable("CONS FAKE BD", enhancedEntryTime, perfectEntryLevel, consolidationSupport - (niftyStopLoss * syminfo.mintick), consolidationResistance, 50, 2500.0, "Active", 0.0, bar_index)
    perfectEntryTriggered := true

// Both Sides Trap Pattern
if showWhipsawSignals and shouldShowSignals() and bothSidesTrapActive and not bothSidesTrapTriggered
    enhancedEntryTime := getCurrentTimeString()
    bothTrapLabelText = "BOTH SIDES TRAP"
    
    // Determine direction based on final move
    isBullishTrap = high > trapHigh + (trapHigh - trapLow) * 0.5
    
    // Declare variables for both conditions
    bothTrapLabelY = 0.0
    bothTrapColor = color.white
    bothTrapLabelStyle = label.style_label_up
    bothTrapEntryLevel = 0.0
    bothTrapStopLevel = 0.0
    bothTrapTargetLevel = 0.0
    
    if isBullishTrap
        bothTrapLabelY := getLabelY(low, false, "BOTH_SIDES_TRAP")
        bothTrapColor := color.new(color.green, 20)
        bothTrapLabelStyle := label.style_label_up
        bothTrapEntryLevel := perfectEntryLevel > 0 ? perfectEntryLevel : close
        bothTrapStopLevel := trapLow
        bothTrapTargetLevel := trapHigh + (trapHigh - trapLow) * 1.5
    else
        bothTrapLabelY := getLabelY(high, true, "BOTH_SIDES_TRAP") 
        bothTrapColor := color.new(color.red, 20)
        bothTrapLabelStyle := label.style_label_down
        bothTrapEntryLevel := perfectEntryLevel > 0 ? perfectEntryLevel : close
        bothTrapStopLevel := trapHigh
        bothTrapTargetLevel := trapLow - (trapHigh - trapLow) * 1.5
    
    bothTrapTooltipText = "BOTH SIDES TRAP PATTERN\nEntry Time: " + enhancedEntryTime + "\nEntry: " + str.tostring(bothTrapEntryLevel, "#.##") + "\nTrap High: " + str.tostring(trapHigh, "#.##") + "\nTrap Low: " + str.tostring(trapLow, "#.##") + "\nPattern: Multiple counter-moves trap both bulls and bears before explosive " + (isBullishTrap ? "upward" : "downward") + " move"
    bothSidesTrapLabel := label.new(bar_index, bothTrapLabelY, bothTrapLabelText, color=bothTrapColor, style=bothTrapLabelStyle, textcolor=color.white, size=size.small, tooltip=bothTrapTooltipText)
    line.new(bar_index, bothTrapLabelY, bar_index, isBullishTrap ? low + connectionGap : high - connectionGap, color=bothTrapColor, width=2, style=line.style_solid)
    
    // Add to trade table
    direction = isBullishTrap ? "LONG" : "SHORT"
    addTradeToTable("BOTH SIDES TRAP " + direction, enhancedEntryTime, bothTrapEntryLevel, bothTrapStopLevel, bothTrapTargetLevel, 50, 2500.0, "Active", 0.0, bar_index)
    bothSidesTrapTriggered := true

// ============================================================================
// TRENDING DAY LABELS
// ============================================================================

// Display Trending Day Label when conditions are met
if shouldShowSignals() and not trendingDayLabelShown and (trendingDayBullish or trendingDayBearish)
    trendingDayTime := getCurrentTimeString()
    
    // Use existing variables for label properties (avoid shadowing)
    trendLabelText = ""
    trendLabelColor = color.white
    trendLabelStyle = label.style_label_up
    trendLabelY = 0.0
    trendTooltipText = ""
    
    // Determine label properties based on trending day type
    if trendingDayBullish
        trendLabelText := "📈 BULLISH TRENDING DAY\n" + trendingDayPattern
        trendLabelColor := color.new(color.green, 0)
        trendLabelStyle := label.style_label_up
        trendLabelY := getLabelY(low, false, "TRENDING_DAY")
        trendTooltipText := "Bullish Trending Day Detected: " + trendingDayPattern + ". Two or more bullish setups in same direction indicate strong upward momentum. Expect continuation to higher levels."
    else if trendingDayBearish
        trendLabelText := "📉 BEARISH TRENDING DAY\n" + trendingDayPattern
        trendLabelColor := color.new(color.red, 0)
        trendLabelStyle := label.style_label_down
        trendLabelY := getLabelY(high, true, "TRENDING_DAY")
        trendTooltipText := "Bearish Trending Day Detected: " + trendingDayPattern + ". Two or more bearish setups in same direction indicate strong downward momentum. Expect continuation to lower levels."
    
    // Create trending day label
    trendingDayLabel := label.new(bar_index, trendLabelY, trendLabelText, color=trendLabelColor, style=trendLabelStyle, textcolor=color.white, size=size.normal, tooltip=trendTooltipText)
    line.new(bar_index, trendLabelY, bar_index, trendingDayBullish ? low + connectionGap : high - connectionGap, color=trendLabelColor, width=2, style=line.style_solid)
    
    trendingDayLabelShown := true

// ============================================================================
// ZONE CHANGE ALERTS & STATUS
// ============================================================================

// Zone change alerts
if zoneChanged and shouldShowSignals()
    alertMessage = "📍 ZONE CHANGE: " + previousZone + " → " + currentZone + " | " + getTradeEmphasis()
    alert(alertMessage)

// Aggressive opportunity alerts  
if shouldShowSignals() and (isAggressiveBullishZone or isAggressiveBearishZone)
    if isAggressiveBullishZone and not na(ta.barssince(not isAggressiveBullishZone)) and ta.barssince(not isAggressiveBullishZone) == 0
        alert("🚀 AGGRESSIVE BULLISH ZONE: R1-R2 Range - Don't Miss Bullish Setups!")
    if isAggressiveBearishZone and not na(ta.barssince(not isAggressiveBearishZone)) and ta.barssince(not isAggressiveBearishZone) == 0
        alert("🚀 AGGRESSIVE BEARISH ZONE: S1-S2 Range - Don't Miss Bearish Setups!")

// ============================================================================
// WHIPSAW ENTRY SIGNALS
// ============================================================================

// Whipsaw Long Signals (2LL/3LL reversal)
if showWhipsawSignals and shouldShowSignals() and whipsawLongCondition and not whipsawLongTriggered
    whipsawLongEntryTime := getCurrentTimeString()
    whipsawText = threeLL ? "3LL REVERSAL LONG" : "2LL REVERSAL LONG"
    tooltipText = (threeLL ? "Three" : "Two") + " consecutive lower lows detected. Price broke above recent swing high, indicating potential reversal from oversold condition. Entry: Close at reversal candle. SL: max(SwingLow, Entry-35pts). Target: ORH/ORL range distance or nearest R1/R2/R3 pivot above entry."
    labelText = whipsawText
    labelY = getLabelY(low, false, "WHIPSAW")
    whipsawLongLabel := label.new(bar_index, labelY, labelText, color=color.lime, style=label.style_label_up, textcolor=color.white, size=size.small, tooltip=tooltipText)
    line.new(bar_index, labelY, bar_index, low + connectionGap, color=color.lime, width=1, style=line.style_dashed)
    whipsawLongTriggered := true

// Whipsaw Short Signals (2HH/3HH reversal)
if showWhipsawSignals and shouldShowSignals() and whipsawShortCondition and not whipsawShortTriggered
    whipsawShortEntryTime := getCurrentTimeString()
    whipsawText = threeHH ? "3HH REVERSAL SHORT" : "2HH REVERSAL SHORT"
    tooltipText = (threeHH ? "Three" : "Two") + " consecutive higher highs detected. Price broke below recent swing low, indicating potential reversal from overbought condition. Entry: Close at reversal candle. SL: min(SwingHigh, Entry+35pts). Target: ORH/ORL range distance or nearest S1/S2/S3 pivot below entry."
    labelText = whipsawText
    labelY = getLabelY(high, true, "WHIPSAW")
    whipsawShortLabel := label.new(bar_index, labelY, labelText, color=color.maroon, style=label.style_label_down, textcolor=color.white, size=size.small, tooltip=tooltipText)
    line.new(bar_index, labelY, bar_index, high - connectionGap, color=color.maroon, width=1, style=line.style_dashed)
    whipsawShortTriggered := true

// Fake Breakout Long Signals (Consolidation + Fake Breakdown = Sharp Move Up)
if showWhipsawSignals and shouldShowSignals() and fakeBreakoutLongCondition and not fakeBreakoutLongTriggered
    fakeBreakoutLongEntryTime := getCurrentTimeString()
    labelText = "FAKE BREAKDOWN LONG"
    labelY = getLabelY(low, false, "WHIPSAW")
    fakeBreakoutLongLabel := label.new(bar_index, labelY, labelText, color=color.green, style=label.style_label_up, textcolor=color.white, size=size.small, tooltip="Fake Breakdown: After consolidation and multiple rejections, price faked breakdown below ORL then reversed sharply upward, trapping bears. Entry: Close at reversal candle. SL: Always ORL level (fake breakdown reversal point). Target: ORH/ORL range distance or nearest R1/R2/R3 pivot above entry.")
    line.new(bar_index, labelY, bar_index, low + connectionGap, color=color.green, width=1, style=line.style_dashed)
    fakeBreakoutLongTriggered := true

// Fake Breakout Short Signals (Consolidation + Fake Breakout = Sharp Move Down)
if showWhipsawSignals and shouldShowSignals() and fakeBreakoutShortCondition and not fakeBreakoutShortTriggered
    fakeBreakoutShortEntryTime := getCurrentTimeString()
    labelText = "FAKE BREAKOUT SHORT"
    labelY = getLabelY(high, true, "WHIPSAW")
    fakeBreakoutShortLabel := label.new(bar_index, labelY, labelText, color=color.orange, style=label.style_label_down, textcolor=color.white, size=size.small, tooltip="Fake Breakout Short: After consolidation and multiple rejections, price faked breakout above ORH then reversed sharply downward, trapping bulls. Entry: Close at reversal candle. SL: Always ORH level (fake breakout reversal point). Target: ORH/ORL range distance or nearest S1/S2/S3 pivot below entry.")
    line.new(bar_index, labelY, bar_index, high - connectionGap, color=color.orange, width=1, style=line.style_dashed)
    fakeBreakoutShortTriggered := true

// Trade table is updated directly above (not as function call)

// Function to detect End of Trading Day (EOD)
isEOD() =>
    // Check if we're at the last trading minute (15:30) or transitioning out of trading session
    not isTradingSession() and isTradingSession()[1]

// Update trade statuses when exits occur (works on both real-time and historical data)
// Check all active trades in the table for exit conditions
if array.size(tradeSignals) > 0 and array.size(tradeStatuses) > 0 and array.size(tradePnLs) > 0 and array.size(tradeExitTimes) > 0
    for i = 0 to array.size(tradeSignals) - 1
        if i < array.size(tradeSignals) and i < array.size(tradeStatuses) and i < array.size(tradeEntries) and i < array.size(tradeStops) and i < array.size(tradeTargets)
            signalType = array.get(tradeSignals, i)
            currentStatus = array.get(tradeStatuses, i)
            entry = array.get(tradeEntries, i)
            stop = array.get(tradeStops, i)
            target = array.get(tradeTargets, i)
            
            // Only check active trades that haven't exited yet
            if str.contains(currentStatus, "Active")
                exitTriggered = false
                exitStatus = ""
                pnl = 0.0
                exitPrice = 0.0
                
                // Determine trade direction once at the beginning
                isShortTrade = str.contains(signalType, "SHORT") or str.contains(signalType, "BULL TRAP") or signalType == "CONS FAKE BO"
                
                // Check for End of Day closure first
                if isEOD()
                    exitTriggered := true
                    exitStatus := "EOD Hit"
                    exitPrice := close
                    // Calculate EOD P&L based on close price
                    if isShortTrade
                        pnl := entry - exitPrice  // Short P&L: entry - exit
                    else
                        pnl := exitPrice - entry  // Long P&L: exit - entry
                else
                    // Check normal exit conditions based on signal type
                    
                    if isShortTrade
                        // SHORT trades: check if low <= target or high >= stop
                        if low <= target
                            exitTriggered := true
                            exitStatus := "Target Hit"
                            exitPrice := target
                            pnl := entry - target
                        else if high >= stop
                            exitTriggered := true
                            exitStatus := "SL Hit"
                            exitPrice := stop
                            pnl := (stop - entry) * -1
                    else
                        // LONG trades: check if high >= target or low <= stop
                        if high >= target
                            exitTriggered := true
                            exitStatus := "Target Hit"
                            exitPrice := target
                            pnl := target - entry
                        else if low <= stop
                            exitTriggered := true
                            exitStatus := "SL Hit"
                            exitPrice := stop
                            pnl := (entry - stop) * -1
                
                // Update trade status if exit occurred
                if exitTriggered
                    array.set(tradeStatuses, i, exitStatus)
                    array.set(tradePnLs, i, pnl)
                    array.set(tradeExitTimes, i, getCurrentTimeString())
                    
                    // Create visual exit marker on chart (if enabled)
                    if showExitMarkers
                        // Create exit marker with appropriate styling for EOD vs normal exits
                        createExitMarker(signalType, exitStatus, isShortTrade, target, stop, pnl)
                    
                    // 🎯 ON-SCREEN ALERT for EXIT
                    if showExitAlerts and enableOnScreenAlerts
                        pnlText = pnl > 0 ? "+" + str.tostring(pnl, "#.#") : str.tostring(pnl, "#.#")
                        exitIcon = if str.contains(exitStatus, "Target")
                            "🎯"
                        else if str.contains(exitStatus, "SL")
                            "❌"
                        else
                            "🌅"
                        
                        alertMsg = signalType + " EXIT " + exitIcon + "\n" + exitStatus + "\nExit: " + str.tostring(exitPrice, "#.##") + "\nP&L: " + pnlText + " pts\nTime: " + getCurrentTimeString()
                        alertPriority = str.contains(exitStatus, "Target") ? 3 : 2
                        exitColor = str.contains(exitStatus, "Target") ? color.green : (str.contains(exitStatus, "SL") ? color.red : color.orange)
                        
                        array.push(alertMessages, alertMsg)
                        array.push(alertTypes, "EXIT")
                        array.push(alertBarIndexes, bar_index)
                        array.push(alertColors, exitColor)
                        array.push(alertPriorities, alertPriority)
                        array.push(alertIcons, exitIcon)
                        array.push(alertDismissed, false)
                        array.push(alertIDs, alertCounter)
                        alertCounter += 1

    // NOTE: Legacy updateTradeStatus calls removed - all exit tracking now handled by array-based system

// ============================================================================
// ON-SCREEN ALERT DISPLAY SYSTEM - PHASE 1
// ============================================================================

// Clear all alerts if toggle is activated
if clearAllAlerts
    alertMessages := array.new<string>()
    alertTypes := array.new<string>()
    alertBarIndexes := array.new<int>()
    alertColors := array.new<color>()
    alertPriorities := array.new<int>()
    alertIcons := array.new<string>()
    alertDismissed := array.new<bool>()
    alertIDs := array.new<int>()

// Clean expired alerts every bar with new dismissal logic
if enableOnScreenAlerts and array.size(alertMessages) > 0
    newMessages = array.new<string>()
    newTypes = array.new<string>()
    newBarIndexes = array.new<int>()
    newColors = array.new<color>()
    newPriorities = array.new<int>()
    newIcons = array.new<string>()
    newDismissed = array.new<bool>()
    newIDs = array.new<int>()
    
    // Determine alert duration based on dismissal mode
    effectiveDuration = switch manualDismissMode
        "Quick Dismiss (5 bars)" => 5
        "Extended Time (20 bars)" => 20
        "Manual Reset" => 999  // Very long duration, user controls
        => alertDuration  // Default: Auto-Expire Only
    
    for i = 0 to array.size(alertMessages) - 1
        alertBar = array.get(alertBarIndexes, i)
        alertPriority = array.get(alertPriorities, i)
        alertType = array.get(alertTypes, i)
        
        // Priority filtering
        shouldShow = true
        if priorityOnlyMode
            shouldShow := alertPriority >= 3 or alertType == "EXIT"
        
        // Keep alert if not expired and passes filters
        if (bar_index - alertBar <= effectiveDuration) and shouldShow
            array.push(newMessages, array.get(alertMessages, i))
            array.push(newTypes, alertType)
            array.push(newBarIndexes, alertBar)
            array.push(newColors, array.get(alertColors, i))
            array.push(newPriorities, alertPriority)
            array.push(newIcons, array.get(alertIcons, i))
            array.push(newDismissed, array.get(alertDismissed, i))
            array.push(newIDs, array.get(alertIDs, i))
    
    alertMessages := newMessages
    alertTypes := newTypes
    alertBarIndexes := newBarIndexes
    alertColors := newColors
    alertPriorities := newPriorities
    alertIcons := newIcons
    alertDismissed := newDismissed
    alertIDs := newIDs

// Create alert display table
if enableOnScreenAlerts and array.size(alertMessages) > 0
    var alertTable = table.new(getAlertTablePosition(), 3, maxSimultaneousAlerts + 1, bgcolor=color.new(color.white, 95), border_width=1)
    
    // Clear table
    table.clear(alertTable, 0, 0, 2, maxSimultaneousAlerts)
    
    // Header with control info
    table.cell(alertTable, 0, 0, "🔔 LIVE ALERTS", text_color=color.black, text_size=getAlertTextSize(), bgcolor=color.new(color.gray, 80))
    table.cell(alertTable, 1, 0, "(" + str.tostring(array.size(alertMessages)) + ")", text_color=color.black, text_size=size.small, bgcolor=color.new(color.gray, 80))
    
    // Control status
    controlText = switch manualDismissMode
        "Quick Dismiss (5 bars)" => "⚡ Quick"
        "Extended Time (20 bars)" => "⏰ Extended"
        "Manual Reset" => "🔒 Manual"
        => "⏱️ Auto"
    
    if priorityOnlyMode
        controlText := controlText + " | ⭐ Priority"
    
    table.cell(alertTable, 2, 0, controlText, text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.gray, 80), tooltip="Current alert control mode. Use settings to change.")
    
    // Display alerts (most recent first, limited by maxSimultaneousAlerts)
    alertsToShow = math.min(array.size(alertMessages), maxSimultaneousAlerts)
    
    for i = 0 to alertsToShow - 1
        if i < array.size(alertMessages)
            alertIndex = array.size(alertMessages) - 1 - i  // Newest first
            
            alertMsg = array.get(alertMessages, alertIndex)
            alertColor = array.get(alertColors, alertIndex)
            alertIcon = array.get(alertIcons, alertIndex)
            alertBar = array.get(alertBarIndexes, alertIndex)
            alertAge = bar_index - alertBar
            alertPriority = array.get(alertPriorities, alertIndex)
            
            // Apply flashing effect for new alerts
            isFlashing = enableFlashing and alertAge <= flashDuration
            currentColor = isFlashing and (bar_index % 2 == 0) ? color.new(alertColor, 20) : color.new(alertColor, alertTransparency)
            
            // Display alert with age indicator
            table.cell(alertTable, 0, i + 1, alertIcon, text_color=color.white, text_size=getAlertTextSize(), bgcolor=currentColor)
            
            // Alert message with age info
            ageText = str.tostring(alertAge) + " bars ago"
            priorityText = alertPriority >= 3 ? " ⭐" : ""
            cellTooltip = "Alert age: " + ageText + priorityText + "\nMode: " + manualDismissMode
            table.cell(alertTable, 1, i + 1, alertMsg, text_color=color.white, text_size=getAlertTextSize(), bgcolor=currentColor, tooltip=cellTooltip)
            
            // Age and priority indicator with matching alert color
            // Use the same color logic as the main alert cell
            ageColor = isFlashing and (bar_index % 2 == 0) ? color.new(alertColor, 20) : color.new(alertColor, alertTransparency)
            table.cell(alertTable, 2, i + 1, ageText + priorityText, text_color=color.white, text_size=size.tiny, bgcolor=ageColor)

// ============================================================================
// ALERTS
// ============================================================================

// ORB Alerts
alertcondition(orbLongCondition, "ORB Long Entry", "ORB Long Entry Signal - Entry: {{close}}, Stop: {{plot('Stop Loss')}}")
alertcondition(orbShortCondition, "ORB Short Entry", "ORB Short Entry Signal - Entry: {{close}}, Stop: {{plot('Stop Loss')}}")

// Trap Alerts
alertcondition(bullTrapCondition, "Bull Trap", "Bull Trap Signal - Entry: {{close}}, Stop: {{plot('Stop Loss')}}")
alertcondition(bearTrapCondition, "Bear Trap", "Bear Trap Signal - Entry: {{close}}, Stop: {{plot('Stop Loss')}}")

// Consolidation Breakout Alerts
alertcondition(consolidationBreakoutLong, "Consolidation Breakout Long", "Consolidation Breakout Long Signal")
alertcondition(consolidationBreakoutShort, "Consolidation Breakout Short", "Consolidation Breakout Short Signal")

// ============================================================================
// WHIPSAW ALERTS
// ============================================================================

// Whipsaw Pattern Formation Alerts
alertcondition(twoLL, "2LL Pattern Formed", "Two Lower Lows Pattern Detected - Potential Reversal Setup")
alertcondition(threeLL, "3LL Pattern Formed", "Three Lower Lows Pattern Detected - Strong Reversal Setup")
alertcondition(twoHH, "2HH Pattern Formed", "Two Higher Highs Pattern Detected - Potential Reversal Setup")
alertcondition(threeHH, "3HH Pattern Formed", "Three Higher Highs Pattern Detected - Strong Reversal Setup")

// Whipsaw Entry Alerts
alertcondition(whipsawLongCondition, "Whipsaw Long Entry", "Whipsaw Long Entry Signal - LL Pattern Reversal Confirmed")
alertcondition(whipsawShortCondition, "Whipsaw Short Entry", "Whipsaw Short Entry Signal - HH Pattern Reversal Confirmed")

// Fake Breakout Alerts  
alertcondition(fakeBreakoutLongCondition, "Fake Breakdown Long", "Fake Breakdown Long Signal - Consolidation Reversal")
alertcondition(fakeBreakoutShortCondition, "Fake Breakout Short", "Fake Breakout Short Signal - Consolidation Reversal")

// Note: Exit alerts can be added by monitoring the exit status changes in dynamic labels

// Consolidation Phase Alert
alertcondition(consolidationPhase, "Consolidation Phase", "Consolidation Phase Detected - Multiple Rejections at ORH/ORL")

// Advanced Pattern Alerts
alertcondition(fakeBreakoutAboveORH, "Fake Breakout Above ORH", "Fake Breakout Above ORH Detected - Potential Sharp Reversal")
alertcondition(fakeBreakdownBelowORL, "Fake Breakdown Below ORL", "Fake Breakdown Below ORL Detected - Potential Sharp Reversal")

// ORH/ORL Breakout/Breakdown Alerts (as per documentation requirements)
orhBreakoutAlert = orhDetermined and close > orh and close[1] <= orh
orlBreakdownAlert = orlDetermined and close < orl and close[1] >= orl
alertcondition(orhBreakoutAlert, "ORH Breakout", "ORH Breakout - Price broke above Opening Range High")
alertcondition(orlBreakdownAlert, "ORL Breakdown", "ORL Breakdown - Price broke below Opening Range Low")



// ============================================================================
// ESSENTIAL VISUAL MARKERS ONLY
// ============================================================================

// Only keep essential markers that provide value:

// ORH/ORL Breakout markers (primary signals) - Show EVERY breakout
plotshape(showEntrySignals and shouldShowSignals() and orhDetermined and close > orh and close[1] <= orh, "ORH Breakout", style=shape.triangleup, location=location.abovebar, color=color.yellow, size=size.small, text="ORH BO")
plotshape(showEntrySignals and shouldShowSignals() and orlDetermined and close < orl and close[1] >= orl, "ORL Breakout", style=shape.triangledown, location=location.belowbar, color=color.yellow, size=size.small, text="ORL BO")

// Whipsaw Pattern Detection Shapes (small indicators) - Fixed logic
plotshape(showWhipsawSignals and shouldShowSignals() and twoLLNew, "2LL Pattern", style=shape.circle, location=location.belowbar, color=color.lime, size=size.tiny, text="2LL")
plotshape(showWhipsawSignals and shouldShowSignals() and threeLLNew, "3LL Pattern", style=shape.circle, location=location.belowbar, color=color.green, size=size.tiny, text="3LL")
plotshape(showWhipsawSignals and shouldShowSignals() and twoHHNew, "2HH Pattern", style=shape.circle, location=location.abovebar, color=color.orange, size=size.tiny, text="2HH")
plotshape(showWhipsawSignals and shouldShowSignals() and threeHHNew, "3HH Pattern", style=shape.circle, location=location.abovebar, color=color.red, size=size.tiny, text="3HH")