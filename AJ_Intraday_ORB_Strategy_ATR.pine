alertPosition = input.string("top_left", "Alert Position", options=["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"], tooltip="Position of alert notifications on chart", group="📢 On-Screen Alerts")
alertSize = input.string("large", "Alert Text Size", options=["tiny", "small", "normal", "large", "huge"], tooltip="Size of alert text for visibility", group="📢 On-Screen Alerts")
maxSimultaneousAlerts = input.int(3, "Max Simultaneous Alerts", minval=1, maxval=5, tooltip="Maximum number of alerts to show at once", group="📢 On-Screen Alerts")

// Alert Type Controls
showEntryAlerts = input.bool(true, "🚀 Entry Signal Alerts", tooltip="Show alerts for ORB, Trap, and Consolidation entry signals", group="Alert Types")
showExitAlerts = input.bool(true, "🎯 Exit Signal Alerts", tooltip="Show alerts when trades hit Target, Stop Loss, or EOD", group="Alert Types")
showBlockedAlerts = input.bool(true, "❌ Position Blocked Alerts", tooltip="Show alerts when positions are blocked due to limits", group="Alert Types")
soundEnabled = input.bool(false, "🔊 Enable Alert Sounds", tooltip="Play sound with alerts (requires TradingView Pro)", group="Alert Types")

// Alert Visual Settings
enableFlashing = input.bool(true, "✨ Enable Alert Flashing", tooltip="Make alerts flash for first few bars to grab attention", group="Alert Visuals")
flashDuration = input.int(3, "Flash Duration (Bars)", minval=1, maxval=8, tooltip="How many bars alerts should flash", group="Alert Visuals")
