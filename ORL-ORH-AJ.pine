//@version=5
indicator(title="ORL/ORH v1", overlay=true,max_lines_count = 500)


// General User Inputs 
//==============================================================================
// Set the date range
startDate = input.int(title='Start Date', defval=1, minval=1, maxval=31, group='General User Inputs')
startMonth = input.int(title='Start Month', defval=1, minval=1, maxval=12, group='General User Inputs')
startYear = input.int(title='Start Year', defval=2023, minval=1970, maxval=2100, group='General User Inputs')

endDate = input.int(title='End Date', defval=31, minval=1, maxval=31, group='General User Inputs')
endMonth = input.int(title='End Month', defval=12, minval=1, maxval=12, group='General User Inputs')
endYear = input.int(title='End Year', defval=2023, minval=1970, maxval=2100, group='General User Inputs')
// Look if the current_close time of the current bar falls inside the date range
inDateRange = time >= timestamp(syminfo.timezone, startYear, startMonth, startDate, 0, 0) and time < timestamp(syminfo.timezone, endYear, endMonth, endDate, 0, 0)
date_range = input.bool(false, title='Use the date range above to mark the Candlestick Setups?', group='General User Inputs')







orhColor = input.color(color.red, "ORH COLOR")
orlColor = input.color(color.green, "ORL COLOR")

// tablo = table.new(position = position.top_right, columns = 2, rows = 2 , bgcolor = color.black, border_width = 2, frame_width=1,frame_color = color.white, border_color=color.white)
// table.merge_cells(tablo, 0,0,0,1)
//table.cell(tablo,0,0,text="1 - , 2- Buyers 3- Sellers",bgcolor = color.black, text_color = color.white)
GetLow(condition, series=low) =>
    var bool lowFound = na
    var line lowLine = na
    var lowBar = 0
    if(condition)
        lowFound := false        
        lowBar := 0
         
    var float lowestValueSince = na
    if (condition or series < lowestValueSince) and lowFound == false
        lowestValueSince := series
        lowBar := lowBar + 1

    if ( not condition and lowestValueSince < series and lowFound == false)
        lowFound := true
         
    lowBar
GetHigh(condition, series=high) =>
    var float highestValueSince = na
    var bool highFound = na
    var line highLine = na
    var highBar = 0
    //var barCount = 0
    if(condition)
        highFound := false
        highBar := 0
    if condition or series > highestValueSince and highFound == false
        highestValueSince := series
        highBar := highBar + 1

    if ( not condition and highestValueSince > series and highFound == false)
        highFound := true
    
    highBar
GetCount(condition) =>    
    var barCount = 0
    if(condition)
        barCount := 0   
    barCount := barCount + 1
    barCount

// GetLowestSince() returns the lowest value of the given series
// since the most recent occurrence of the specified condition.
// Returns 'na' when that condition has not happened yet, or when
// the series was 'na' when the condition occurred.
GetLowestSince(condition, series=low) =>
    var bool lowFound = na
    var line lowLine = na
    
    if(condition)
        lowFound := false
        line.set_x2(lowLine, bar_index)
        line.set_extend(lowLine, extend.none)  
        
         
    var float lowestValueSince = na
    if (condition or series < lowestValueSince) and lowFound == false
        lowestValueSince := series
        
    if ( not condition and lowestValueSince < series and lowFound == false)
        lowFound := true
        
        lowLine := line.new(x1=bar_index[1], y1=low[1], x2=bar_index[1], y2=low[1], extend=extend.right, color= orhColor)
        if not na(lowLine) and line.get_x2(lowLine) != bar_index
            line.set_x2(lowLine, bar_index)
    lowestValueSince



// GetHighestSince() returns the highest value of the given series
// since the most recent occurrence of the specified condition.
// Returns 'na' when that condition has not happened yet, or when
// the series was 'na' when the condition occurred.
GetHighestSince(condition, series=high) =>
    var float highestValueSince = na
    var bool highFound = na
    var line highLine = na
    if(condition)
        highFound := false
        line.set_x2(highLine, bar_index)
        line.set_extend(highLine, extend.none)
    if condition or series > highestValueSince and highFound == false
        highestValueSince := series
    if ( not condition and highestValueSince > series and highFound == false)
        highFound := true
        highLine := line.new(x1=bar_index[1], y1=high[1], x2=bar_index[1], y2=high[1], extend=extend.right, color=orlColor)
        if not na(highLine) and line.get_x2(highLine) != bar_index
            line.set_x2(highLine, bar_index)
    highestValueSince




newday = ta.change(time("D"))


