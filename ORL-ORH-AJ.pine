checkORLORHBreakDown(hh, ll, barCount, confirmORH, confirmORL) =>
    var retValue =0 
    var buyCandle = false
    var sellCandle = false
    var lowTouch = false
    var highTouch = false
    if newday
        retValue := 0
        lowTouch := false
        highTouch := false
        buyCandle := false
        sellCandle := false
    if (confirmORH == true and confirmORL == true)
        // table.cell(tablo,0,1,text="1",bgcolor = color.black, text_color = color.white)
        //retValue := 1
        lowTouch := true
        highTouch := true

        retValue := open[2] > close[2] ? 4 : open[2] < close[2] ? 1 : 0 
        //xx = ta.valuewhen(buyBar, bar_index,0)
        if not(date_range == true and inDateRange == false)  // Plot only if the bar is in date range, or the feature has been turned off 
            oe=label.new(bar_index, (retValue == 1 or retValue == 2 ? hh : ll), '' + str.tostring(retValue == 1 or retValue == 2 ? "OR CONTROL = BUYERS" : retValue == 3 or retValue == 4 ? "OR CONTROL = SELLERS" : "" ),textcolor= (retValue == 1 or retValue == 2 ? color.green : color.red), style=label.style_none, color=color.black)
    //label.delete(oe[1]) 
    else if (confirmORH == true and lowTouch == true)
        
        retValue := 2
        if not(date_range == true and inDateRange == false)  // Plot only if the bar is in date range, or the feature has been turned off 
            oe1=label.new(bar_index, (retValue == 1 or retValue == 2 ? hh : ll), '' + str.tostring(retValue == 1 or retValue == 2 ? "OR CONTROL = BUYERS" : retValue == 3 or retValue == 4 ? "OR CONTROL = SELLERS" : "" ),textcolor= (retValue == 1 or retValue == 2 ? color.green : color.red), style=label.style_none, color=color.black)
    else if (confirmORL == true and highTouch == true)
        // table.clear(tablo,0,1)
        // table.cell(tablo,0,1,text="3",bgcolor = color.black, text_color = color.white)
        retValue := 3
        if not(date_range == true and inDateRange == false)  // Plot only if the bar is in date range, or the feature has been turned off 
            oe2=label.new(bar_index, (retValue == 1 or retValue == 2 ? hh : ll), '' + str.tostring(retValue == 1 or retValue == 2 ? "OR CONTROL = BUYERS" : retValue == 3 or retValue == 4 ? "OR CONTROL = SELLERS" : "" ),textcolor= (retValue == 1 or retValue == 2 ? color.green : color.red), style=label.style_none, color=color.black)
    else if (confirmORH == true)
        highTouch := true
    else if (confirmORL == true)
        lowTouch := true
    
    // if retValue == 1
    //     oe=label.new(bar_index, ll, '' + str.tostring(retValue == 1 or retValue == 2 ? "BUY - ORH" : retValue == 3 or retValue == 4 ? "SELL - ORH" : "" ),textcolor=color.green, style=label.style_none, color=color.black)
    // else if retValue == 2
    //     oe1=label.new(bar_index, ll, '' + str.tostring(retValue == 1 or retValue == 2 ? "BUY - ORH" : retValue == 3 or retValue == 4 ? "SELL - ORH" : "" ),textcolor=color.green, style=label.style_none, color=color.black)
    // if retValue == 3
    //     oe2=label.new(bar_index, hh, '' + str.tostring(retValue == 1 or retValue == 2 ? "BUY - ORH" : retValue == 3 or retValue == 4 ? "SELL - ORH" : "" ),textcolor=color.red, style=label.style_none, color=color.black)
    // else if retValue == 4
    //     oe3=label.new(bar_index, hh, '' + str.tostring(retValue == 1 or retValue == 2 ? "BUY - ORH" : retValue == 3 or retValue == 4 ? "SELL - ORH" : "" ),textcolor=color.red, style=label.style_none, color=color.black)

    if retValue == 1 and close > hh and buyCandle == false
        buyCandle := true
        sellCandle := false
    else if retValue == 1 and close < ll and sellCandle == false
        sellCandle := true
        buyCandle := false
        // sellCandle := false
    else if retValue == 2 and close > hh and buyCandle == false
        buyCandle := true
        sellCandle := false
    else if retValue == 2 and close < ll and sellCandle == false
        sellCandle := true
        buyCandle := false
    else if retValue == 3 and close > hh and buyCandle == false
        buyCandle := true
        sellCandle := false
    else if retValue == 3 and close < ll and sellCandle == false
        sellCandle := true
        buyCandle := false
    else if retValue == 4 and close > hh and buyCandle == false
        buyCandle := true
        sellCandle := false
    else if retValue == 4 and close < ll and sellCandle == false
        sellCandle := true
        buyCandle := false
    
    [retValue, buyCandle, sellCandle]


