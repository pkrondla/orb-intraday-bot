# Copy to .env (git-ignored) at the project root or in config/ and fill in.
# Use a NEW, data-only Groww API key for this bot. Never reuse the live trading bot's key.

# Groww TOTP credentials, from the Groww API keys page. The bot generates the 6-digit code
# itself and refreshes the daily access token, so nothing needs pasting each morning.
GROWW_TOTP_TOKEN=
GROWW_TOTP_SECRET=

# Where the SQLite db, token cache and spike reports go (git-ignored)
DATA_DIR=data

# Pause token fetching for this long after a 429 (seconds, persisted across restarts)
GROWW_TOKEN_COOLDOWN_SEC=180

# Optional Telegram alerts (trades, exits, daily summary, stall alerts). Leave empty to disable.
# Create a dedicated bot with @BotFather, message it once, then read your chat id from
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional healthchecks.io (or similar) URL. The watchdog pings it while the bot is healthy.
HEALTHCHECK_URL=

# Execution mode. paper = simulated trades only (the default).
# live = the full trading pipeline. It needs LIVE_ARMED=true and Groww credentials; without
# them the bot runs as paper. Trading is on every market day: send /stop on Telegram to skip the
# rest of a day and /start to allow it again.
LIVE_MODE=paper
LIVE_ARMED=false

# true (default) = the dry run: everything runs exactly as live trading (risk checks, real
# bid/ask quotes, order tracking, protective stop, exits, reconciliation, logs, database) but
# the order is NOT sent to the broker. false = real orders. Only DRY_RUN=false can spend money.
DRY_RUN=true

# Optional live-trading TOTP override. Leave empty to reuse GROWW_TOTP_* above.
GROWW_TRADING_TOTP_TOKEN=
GROWW_TRADING_TOTP_SECRET=
